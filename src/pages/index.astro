---
import Layout from '../designs/folio/Layout.astro';
import Nav from '../designs/folio/Nav.astro';
import Hero from '../designs/folio/Hero.astro';
import About from '../designs/folio/About.astro';
import Experience from '../designs/folio/Experience.astro';
import Capabilities from '../designs/folio/Capabilities.astro';
import Work from '../designs/folio/Work.astro';
import Contact from '../designs/folio/Contact.astro';
import Footer from '../designs/folio/Footer.astro';

const title = "Arnav Panigrahi | Backend & AI/ML Software Developer";
const description = "Software developer focused on backend systems, full-stack applications, and AI/ML pipelines. M.S. Computer Science, UC Riverside.";
const image = "jelly.webp";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Arnav Panigrahi",
  "jobTitle": "Software Developer",
  "worksFor": "AllCheer",
  "description": "Software developer focused on backend systems, full-stack applications, and AI/ML pipelines",
  "url": "https://arnavpanigrahi.com",
  "telephone": "+1 951-347-2065",
  "email": "arnav.panigrahi@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Riverside",
    "addressCountry": "US"
  },
  "sameAs": [
    "https://github.com/notquite28",
    "https://www.linkedin.com/in/arnav-panigrahi/"
  ],
  "knowsAbout": [
    "Artificial Intelligence",
    "Machine Learning",
    "Backend Development",
    "Full-Stack Development",
    "Distributed Systems",
    "Python",
    "TypeScript",
    "FastAPI",
    "React",
    "Cloud Computing",
    "Retrieval-Augmented Generation",
    "LLM Integrations",
    "Enterprise Software"
  ],
  "hasOccupation": {
    "@type": "Occupation",
    "name": "Software Developer",
    "description": "Building backend systems, full-stack applications, and AI/ML pipelines"
  },
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "University of California, Riverside",
    "description": "Master of Science in Computer Science (2023-2025)"
  }
};
---

<Layout title={title} description={description} image={image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Nav />
  <Hero />
  <About />
  <Experience />
  <Capabilities />
  <Work />
  <Contact />
  <Footer />
</Layout>
