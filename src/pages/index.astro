---
import BaseLayout from '../components/layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Skills from '../components/sections/Skills.astro';
import Projects from '../components/sections/Projects.astro';
import CTA from '../components/sections/CTA.astro';
import Footer from '../components/sections/Footer.astro';
import Nav from '../components/sections/Nav.astro';

// SEO metadata
const title = "Arnav Panigrahi - Software Developer";
const description = "Software developer focused on backend systems, AI workflows, and production infrastructure.";
const image = "mumei.jpg";

// Structured data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Arnav Panigrahi",
  "jobTitle": "Software Developer",
  "worksFor": "AllCheer",
  "description": "Software developer focused on backend systems, AI workflows, and production infrastructure",
  "url": "https://arnavpanigrahi.com",
  "telephone": "+1 951-347-2065",
  "email": "arnav.panigrahi@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Riverside",
    "addressCountry": "US"
  },
  "sameAs": [
    "https://github.com/notquite28",
    "https://www.linkedin.com/in/arnav-panigrahi/"
  ],
"knowsAbout": [
"Artificial Intelligence",
"Machine Learning", 
"Backend Development",
"Distributed Systems",
"Python",
"FastAPI",
"Cloud Computing",
"RAG Systems",
"AI Agents",
"Enterprise Software"
],
  "hasOccupation": {
    "@type": "Occupation",
    "name": "Software Developer",
    "description": "Building backend systems, AI workflows, and production software"
  },
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "University of California, Riverside",
    "description": "Master of Science in Computer Science (2023-2025)"
  }
};
---

<BaseLayout title={title} description={description} image={image}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <Nav />
  <Hero />
  <About />
  <Skills />
  <Projects />
  <CTA />
  <Footer />
</BaseLayout>
