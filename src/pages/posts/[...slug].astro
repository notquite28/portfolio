---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../designs/folio/Layout.astro';
import Nav from '../../designs/folio/Nav.astro';
import Footer from '../../designs/folio/Footer.astro';
import { buildUrl } from '../../utils/paths';

type Props = {
  post: CollectionEntry<'posts'>;
};

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts');
  return posts.map((post: CollectionEntry<'posts'>) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props as Props;
const { Content } = await render(post);
const title = `${post.data.title} | Arnav Panigrahi`;
const description = post.data.description;
const publishedTime = post.data.published.toISOString();
const modifiedTime = post.data.updated ?? publishedTime;
const postURL = new URL(Astro.url.pathname, Astro.site ?? 'https://arnavpanigrahi.com/').toString();
const socialImageURL = new URL(buildUrl('og-image.png'), Astro.site ?? 'https://arnavpanigrahi.com/').toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: {
    '@type': 'Person',
    name: 'Arnav Panigrahi',
    url: 'https://arnavpanigrahi.com',
  },
  publisher: {
    '@type': 'Person',
    name: 'Arnav Panigrahi',
    url: 'https://arnavpanigrahi.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postURL,
  },
  url: postURL,
  image: socialImageURL,
  keywords: post.data.categories,
};

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
}
---

<Layout
  title={title}
  description={description}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  tags={post.data.categories}
  structuredData={structuredData}
>
  <Nav />
  <article class="post-page">
    <header class="post-header">
      <a class="back-link" href="/posts/">← Posts</a>
      <p>{formatDate(post.data.published)}</p>
      <h1>{post.data.title}</h1>
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
  <Footer />
</Layout>

<style>
  .post-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 8rem clamp(1.5rem, 4vw, 3rem) 4rem;
  }

  .post-header {
    margin-bottom: 4rem;
  }

  .back-link {
    color: var(--c-accent-soft);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--c-ink);
  }

  .post-header p {
    margin: 3rem 0 1rem;
    color: var(--c-accent);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .post-header h1 {
    margin: 0 0 1.5rem;
    color: var(--c-ink);
    font-family: var(--font-serif);
    font-size: clamp(3.25rem, 9vw, 6.75rem);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .post-body {
    color: var(--c-body);
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.85;
  }

  .post-body :global(h1) {
    display: none;
  }

  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    margin: 3rem 0 1rem;
    color: var(--c-ink);
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .post-body :global(h2) { font-size: clamp(2.25rem, 5vw, 3.5rem); }
  .post-body :global(h3) { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .post-body :global(h4) { font-size: clamp(1.35rem, 3vw, 1.8rem); }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol),
  .post-body :global(blockquote),
  .post-body :global(pre) {
    margin: 0 0 1.35rem;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.35rem;
  }

  .post-body :global(ul) {
    list-style: disc;
  }

  .post-body :global(ol) {
    list-style: decimal;
  }

  .post-body :global(li) {
    margin: 0.35rem 0;
  }

  .post-body :global(li::marker) {
    color: var(--c-accent);
  }

  .post-body :global(a) {
    color: var(--c-accent-soft);
    text-underline-offset: 0.18em;
  }

  .post-body :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 42rem;
    height: auto;
    margin: 2rem auto 0.5rem;
    border: 1px solid var(--c-rule);
    border-radius: 1rem;
    box-shadow: var(--shadow-soft);
  }

  .post-body :global(.post-image-row) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 58rem;
    margin: 2rem auto 0.5rem;
  }

  .post-body :global(.post-image-row img) {
    width: 100%;
    height: auto;
    max-height: 34rem;
    margin: 0;
    object-fit: contain;
  }

  .post-body :global(.post-image-row--two) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 42rem;
  }

  @media (max-width: 640px) {
    .post-body :global(.post-image-row) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
      max-width: 100%;
      margin-inline: auto;
    }

    .post-body :global(.post-image-row--two) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .post-body :global(.post-image-row img) {
      width: 100%;
      max-height: none;
    }
  }

  .post-body :global(blockquote) {
    padding-left: 1.25rem;
    border-left: 1px solid var(--c-accent);
    color: var(--c-ink);
    font-style: italic;
  }

  .post-body :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--c-rule);
    border-radius: 0.75rem;
    background: rgba(0, 0, 0, 0.24);
    color: var(--c-ink);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .post-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
</style>
