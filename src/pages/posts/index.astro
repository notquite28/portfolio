---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../designs/folio/Layout.astro';
import Footer from '../../designs/folio/Footer.astro';

const posts: CollectionEntry<'posts'>[] = (await getCollection('posts'))
  .filter((post: CollectionEntry<'posts'>) => import.meta.env.DEV || !post.data.draft)
  .sort(
    (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.published.getTime() - a.data.published.getTime()
  );

const title = 'Posts | Arnav Panigrahi';
const description = 'Technical notes, project writeups, and personal essays by Arnav Panigrahi.';

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en', {
    timeZone: 'UTC',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
}
---

<Layout title={title} description={description}>
  <section class="posts-index">
    <div class="posts-index-inner">
      <a class="home-link" href="/">← Home</a>
      <p class="kicker">Writing</p>
      <h1>Posts</h1>
      <div class="posts-list">
        {posts.map((post: CollectionEntry<'posts'>) => (
          <a class="post-link" href={`/posts/${post.id}/`}>
            <span>{formatDate(post.data.published)}</span>
            <strong>{post.data.title}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .posts-index {
    min-height: 100vh;
    padding: 8rem clamp(1.5rem, 4vw, 3rem) 4rem;
  }

  .posts-index-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  .kicker {
    margin: 0 0 1rem;
    color: var(--c-accent);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 1rem 0 4rem;
    color: var(--c-ink);
    font-family: var(--font-serif);
    font-size: clamp(4rem, 12vw, 8rem);
    font-variation-settings: 'SOFT' 35;
    font-weight: 750;
    letter-spacing: -0.024em;
    line-height: 0.88;
  }

  .home-link {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 3rem;
    color: var(--c-accent-soft);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 200ms var(--ease-expo);
  }

  .home-link:hover {
    color: var(--c-ink);
  }
  .posts-list {
    border-top: 1px solid var(--c-rule);
  }

  .post-link {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--c-rule);
    color: inherit;
    text-decoration: none;
  }

  .post-link span {
    color: var(--c-muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-link strong {
    color: var(--c-ink);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-variation-settings: 'SOFT' 35;
    font-weight: 750;
    letter-spacing: -0.024em;
    line-height: 1;
    transition: color 200ms var(--ease-expo);
  }

  .post-link:hover strong {
    color: var(--c-accent-soft);
  }
</style>
