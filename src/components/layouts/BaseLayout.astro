---
import '../../styles/global.css';
import Oneko from '../ui/Oneko.astro';
import { buildUrl } from '../../utils/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showBoids?: boolean;
  showMascot?: boolean;
}

const { 
  title = "Arnav Panigrahi - Software Developer",
  description = "Software developer focused on backend systems, AI products, and reliable infrastructure.",
  image = "mumei.jpg",
  showBoids = true,
  showMascot = true
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://notquite28.github.io/portfolio/');
const isProd = import.meta.env.PROD;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="author" content="Arnav Panigrahi">
    <meta name="keywords" content="portfolio, developer, software engineer, machine learning, AI, web development">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={buildUrl(image)}>
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={buildUrl(image)}>
    <link rel="canonical" href={canonicalURL}>
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap">
    <link rel="icon" type="image/svg+xml" href={buildUrl('favicon.svg')} />
</head>
<body class="font-sans">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[--color-surface] focus:text-white focus:rounded-full focus:ring-2 focus:ring-[--color-brand-500]">
      Skip to content
    </a>
    {showBoids && <canvas id="boidCanvas"></canvas>}
    
    <main id="main-content" class="relative z-[1]">
        <slot />
    </main>
    
    {showBoids && <script>
        const canvas = document.getElementById('boidCanvas');
        const navigatorWithHints = navigator as Navigator & {
            connection?: { saveData?: boolean };
            mozConnection?: { saveData?: boolean };
            webkitConnection?: { saveData?: boolean };
            deviceMemory?: number;
        };
        const reduceMotionPreference = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const networkConnection = navigatorWithHints.connection || navigatorWithHints.mozConnection || navigatorWithHints.webkitConnection;
        const saveDataPreference = Boolean(networkConnection && networkConnection.saveData);
        const lowPowerDevice = (navigatorWithHints.deviceMemory && navigatorWithHints.deviceMemory <= 4) || window.innerWidth < 768;

        if (canvas instanceof HTMLCanvasElement) {
            if (reduceMotionPreference || saveDataPreference || lowPowerDevice) {
                canvas.remove();
            } else if (canvas.dataset.boidInitialized !== 'true') {
                canvas.dataset.boidInitialized = 'true';

                const script = document.createElement('script');
                script.src = `${import.meta.env.BASE_URL}js/boid-simulation.js`;
                script.defer = true;
                document.body.appendChild(script);
            }
        }
    </script>}

    <script>
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const sections = document.querySelectorAll('.section-transition');

        if (prefersReducedMotion) {
            sections.forEach((section) => section.classList.add('is-visible'));
        } else if (!('IntersectionObserver' in window)) {
            sections.forEach((section) => section.classList.add('is-visible'));
        } else {
            const observer = new IntersectionObserver(
                (entries, currentObserver) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        entry.target.classList.add('is-visible');
                        currentObserver.unobserve(entry.target);
                    });
                },
                {
                    threshold: 0.14,
                    rootMargin: '0px 0px -8% 0px',
                }
            );

            sections.forEach((section) => observer.observe(section));
        }
    </script>
    
    {showMascot && <Oneko position="bottom-right" />}
  {isProd && <script is:inline defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "d82e640ddac84498b86f3aef468f7107"}'></script>}
</body>
</html>
