---
import Icon from '../ui/Icon.astro';

interface SocialLink {
  href: string;
  label: string;
  icon: string;
}

interface Props {
  title?: string;
  description?: string;
  socials?: SocialLink[];
}

const {
  title = 'Contact',
  description = 'Open to software engineering, platform, and applied AI roles.',
  socials = [
    { href: 'mailto:arnav.panigrahi@gmail.com', label: 'Email', icon: 'envelope' },
    { href: 'https://github.com/notquite28', label: 'GitHub', icon: 'github' },
    { href: 'https://www.linkedin.com/in/arnav-panigrahi/', label: 'LinkedIn', icon: 'linkedin' },
    { href: 'https://notquite28.github.io/resume/resumeml.pdf', label: 'Resume', icon: 'file-pdf' }
  ]
} = Astro.props;
---

<section id="cta" class="section-shell section-block section-transition">
  <div class="mx-auto max-w-6xl contact-band">
    <div>
      <p class="section-kicker">Get in touch</p>
      <h2 class="section-title">{title}</h2>
      <p class="section-aside contact-copy">{description}</p>
    </div>

    <div class="contact-links">
      {socials.map((social) => (
        <a href={social.href} class="contact-link" aria-label={social.label} target="_blank" rel="noopener noreferrer">
          <Icon name={social.icon} class="w-5 h-5" />
          <span>{social.label}</span>
        </a>
      ))}
      <button type="button" class="contact-link contact-link-button" data-copy-email="arnav.panigrahi@gmail.com" aria-label="Copy email address">
        <Icon name="copy" class="w-5 h-5" />
        <span class="contact-link-label" aria-live="polite">Copy email</span>
      </button>
    </div>
  </div>
</section>

<script>
  const copyButtons = document.querySelectorAll('[data-copy-email]');

  copyButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;

    const label = button.querySelector('.contact-link-label');
    const email = button.dataset.copyEmail;
    if (!(label instanceof HTMLSpanElement) || !email) return;

    const defaultLabel = label.textContent ?? 'Copy email';
    let resetTimer: number | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'Copied';
        button.dataset.copied = 'true';
      } catch {
        window.location.href = `mailto:${email}`;
        label.textContent = 'Opening email';
      }

      if (resetTimer) window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        label.textContent = defaultLabel;
        delete button.dataset.copied;
      }, 1600);
    });
  });
</script>
