---
import Icon from '../ui/Icon.astro';

interface SocialLink {
  href: string;
  label: string;
  icon: string;
}

interface Props {
  title?: string;
  description?: string;
  socials?: SocialLink[];
}

const {
  title = 'Contact',
  description = 'Open to backend, platform, and applied AI roles.',
  socials = [
    { href: 'mailto:arnav.panigrahi@gmail.com', label: 'Email', icon: 'envelope' },
    { href: 'https://github.com/notquite28', label: 'GitHub', icon: 'github' },
    { href: 'https://www.linkedin.com/in/arnav-panigrahi/', label: 'LinkedIn', icon: 'linkedin' },
    { href: 'https://notquite28.github.io/resume/resumeml.pdf', label: 'Resume', icon: 'file-pdf' }
  ]
} = Astro.props;
---

<section id="cta" class="section-shell section-block section-transition">
  <div class="mx-auto max-w-6xl contact-band">
    <div>
      <p class="section-kicker">Get in touch</p>
      <h2 class="section-title">{title}</h2>
      <p class="section-aside contact-copy">{description}</p>
    </div>

    <div class="contact-links">
      {socials.map((social) => (
        <a href={social.href} class="contact-link" aria-label={social.label} target="_blank" rel="noopener noreferrer">
          <Icon name={social.icon} class="w-5 h-5" />
          <span>{social.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>
