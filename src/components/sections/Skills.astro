---
interface SkillCategory {
    title: string;
    skills: string[];
}

interface Props {
    categories?: SkillCategory[];
}

const defaultCategories: SkillCategory[] = [
    {
        title: "Languages & Frameworks",
        skills: ["Python", "TypeScript", "JavaScript", "C#", ".NET", "FastAPI", "React", "Astro"],
    },
    {
        title: "AI & Data Systems",
        skills: ["LangChain", "LangGraph", "RAG Pipelines", "PyTorch", "LLMs", "Vector Search"],
    },
    {
        title: "Infrastructure & Delivery",
        skills: ["Google Cloud", "Docker", "AWS", "REST APIs", "PostgreSQL", "SQL", "Git"],
    },
];

const { categories = defaultCategories } = Astro.props;
---

<section id="skills" class="section-shell section-block section-transition">
    <div class="mx-auto max-w-6xl">
        <div class="section-header-split">
            <div>
                <p class="section-kicker">Skills</p>
                <h2 class="section-title">Tools I use most.</h2>
            </div>
            <p class="section-aside">Strongest in backend systems, AI workflows, and production delivery.</p>
        </div>

        <div class="capability-stack">
            {
                categories.map((category) => (
                    <div class="capability-block">
                        <p class="capability-title">{category.title}</p>
                        <ul class="capability-list">
                            {category.skills.map((skill) => (
                                <li>{skill}</li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</section>
