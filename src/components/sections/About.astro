---
import { buildUrl } from '../../utils/paths';

interface Props {
  initials?: string;
  paragraphs?: string[];
  imagePath?: string;
}

const defaultParagraphs = [
"Software developer with an MS in Computer Science from UC Riverside, specializing in backend systems, distributed infrastructure, and AI/ML. Over 2.5 years of professional experience shipping production-grade software.",
"At AllCheer, I built a HIPAA-compliant AI system that reduced processing time by 60% and saved $20K annually. I'm focused on scalable systems, ethical AI, and open-source development."
];


const {
  initials = "Q",
  paragraphs = defaultParagraphs,
  imagePath = buildUrl('mumei.webp'),
} = Astro.props;
---

<section
  id="about"
  class="py-16 px-4 section-transition"
>
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-center text-gradient">About Me</h2>

    <div class="flex flex-col md:flex-row gap-8 items-center">
      <div class="md:w-1/3">
        <div class="w-64 h-64 rounded-full mx-auto overflow-hidden shadow-glass glass-liquid" data-glass-interactive data-glass-random>
          <img src={imagePath} alt="Arnav Panigrahi" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>

      <div class="md:w-2/3">
        {paragraphs.map((paragraph) => <p class="mb-4 text-lg text-white/90">{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>
