---
import { buildUrl } from "../../utils/paths";

interface Props {
    paragraphs?: string[];
    imagePath?: string;
}

const defaultParagraphs = [
    "I build across the stack -- backend services, fullstack applications, and AI/ML systems -- with a focus on getting things into production cleanly.",
    "My recent work spans RAG pipelines and LLM agents, REST APIs and cloud deployments, and end-to-end web applications.",
    "I hold a master's degree in computer science from the University of California, Riverside.",
];

const { paragraphs = defaultParagraphs, imagePath = buildUrl("mumei.webp") } = Astro.props;
---

<section id="about" class="section-shell section-block section-transition">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[minmax(15rem,0.7fr)_minmax(0,1.3fr)] lg:items-start">
        <div class="about-media">
            <div class="about-image-wrap">
                <img src={imagePath} alt="Arnav Panigrahi" class="about-image" loading="lazy" />
            </div>
        </div>

        <div>
            <p class="section-kicker">About</p>
            <h2 class="section-title">What I work on.</h2>
            <div class="content-stack">
                {paragraphs.map((paragraph) => <p class="body-copy">{paragraph}</p>)}
            </div>

            <div class="about-facts">
                <div class="about-fact">
                    <p class="panel-label">What I optimize for</p>
                    <p class="body-copy-sm">Simple interfaces, reliable pipelines, and maintainable implementation.</p>
                </div>
                <div class="about-fact">
                    <p class="panel-label">How I work</p>
                    <p class="body-copy-sm">Clear systems and steady iteration.</p>
                </div>
            </div>
        </div>
    </div>
</section>
