---
import Icon from "../ui/Icon.astro";

interface Project {
    title: string;
    description: string;
    tags: string[];
    compactTags?: string[];
    highlights?: string[];
    link?: string;
    githubUrl?: string;
}

interface Props {
    projects?: Project[];
}

const defaultProjects: Project[] = [
    {
        title: "bedtime.ai – Multi-Modal AI Storytelling Platform",
        description: "A multi-modal AI storytelling system that turns children's drawings into narrated stories using Phi-3, EfficientNet, voice cloning, FastAPI, and React.",
        tags: ["React", "FastAPI", "Phi-3", "Computer Vision", "Voice Cloning", "Docker"],
        highlights: ["Multiple models, one application flow", "Built as a product", "Clean API and model orchestration"],
        githubUrl: "https://github.com/notquite28/bedtime.ai",
    },
    {
        title: "Abliteration for LFM2.5",
        description: "An interpretability project for LiquidAI/LFM2.5-1.2B-Instruct focused on refusal directions, weight orthogonalization, and inference-time intervention using manual PyTorch hooks.",
        tags: ["Research", "LLM Interpretability", "PyTorch", "Hugging Face", "Residual Streams", "Inference Intervention"],
        compactTags: ["PyTorch", "Interpretability", "Research"],
        githubUrl: "https://github.com/notquite28/abliteration",
    },
    {
        title: "Edge-Native Real-Time Web Platform",
        description: "A real-time collaborative site built with SvelteKit 5, Cloudflare Workers, Durable Objects, KV-backed analytics, and a custom Vite markdown pipeline.",
        tags: ["SvelteKit 5", "Cloudflare Workers", "Durable Objects", "WebSockets", "Cloudflare KV", "Vite Plugin"],
        compactTags: ["SvelteKit", "Cloudflare", "WebSockets"],
        githubUrl: "https://github.com/notquite28/nier-archive-site",
    },
    {
        title: "Rethink BH Automation – FastAPI + Cloud Run Backend",
        description: "A FastAPI service that syncs Rethink BH appointment and authorization data to Supabase in real time using secure login emulation.",
        tags: ["System Architecture", "FastAPI", "Cloud Run", "Google Cloud", "DevOps", "Automation"],
        compactTags: ["FastAPI", "Cloud Run", "Automation"],
        githubUrl: "",
    },
    {
        title: "RAG for Document Intelligence",
        description: "A RAG system for semantic search over PDFs using Pinecone, Groq, and custom chunking for faster and more relevant retrieval.",
        tags: ["System Design", "AI/ML", "Vector Search", "RAG", "Performance Optimization"],
        compactTags: ["RAG", "Pinecone", "Groq"],
        githubUrl: "https://github.com/notquite28/simpleRAG",
    },
    {
        title: "Enterprise ROI System with AI Agent",
        description: "An AI-driven system for Release of Information workflows that automates the document lifecycle under HIPAA requirements.",
        tags: ["AI Agent", "Enterprise", "Automation", "Legal Tech", "Cost Optimization"],
        compactTags: ["AI Agent", "Automation", "HIPAA"],
        githubUrl: "",
    },
];

const { projects = defaultProjects } = Astro.props;
const [featuredProject, ...otherProjects] = projects;
const secondaryProjects = otherProjects.slice(0, 2);
const compactProjects = otherProjects.slice(2);
---

<section id="projects" class="section-shell section-block section-transition">
    <div class="mx-auto max-w-6xl">
        <div class="section-header-split">
            <div>
                <p class="section-kicker">Selected Works</p>
                <h2 class="section-title">Some stuff I'm proud of.</h2>
            </div>
            <!-- <p class="section-aside">Public repos, research, and production work.</p> -->
        </div>

        {
            featuredProject && (
                <article class="featured-project panel panel-strong">
                    <div class="featured-project-copy">
                        <p class="panel-label">Featured</p>
                        <h3 class="featured-project-title">{featuredProject.title}</h3>
                        <p class="body-copy">{featuredProject.description}</p>
                        <div class="tag-row">
                            {featuredProject.tags.map((tag) => (
                                <span class="tag-pill">{tag}</span>
                            ))}
                        </div>
                    </div>

                    <div class="featured-project-meta">
                        <p class="panel-meta">Highlights</p>
                        <ul class="project-points">
                            {(featuredProject.highlights ?? []).map((item) => (
                                <li>{item}</li>
                            ))}
                        </ul>

                        <div class="project-links">
                            {featuredProject.link && (
                                <a href={featuredProject.link} class="link-inline" target="_blank" rel="noopener noreferrer">
                                    <Icon name="external-link" class="w-3 h-3" /> Live Demo
                                </a>
                            )}
                            {featuredProject.githubUrl && (
                                <a href={featuredProject.githubUrl} class="link-inline" target="_blank" rel="noopener noreferrer">
                                    <Icon name="github" class="w-3 h-3" /> View Code
                                </a>
                            )}
                        </div>
                    </div>
                </article>
            )
        }

        <div class="project-grid project-grid-secondary">
            {
                secondaryProjects.map((project) => (
                    <article class="project-card panel panel-muted">
                        <div>
                            <h3 class="project-card-title">{project.title}</h3>
                            <p class="body-copy-sm">{project.description}</p>
                        </div>

                        <div class="tag-row">
                            {project.tags.map((tag) => (
                                <span class="tag-pill">{tag}</span>
                            ))}
                        </div>

                        <div class="project-links">
                            {project.link && (
                                <a href={project.link} class="link-inline" target="_blank" rel="noopener noreferrer">
                                    <Icon name="external-link" class="w-3 h-3" /> Live Demo
                                </a>
                            )}
                            {project.githubUrl ? (
                                <a href={project.githubUrl} class="link-inline" target="_blank" rel="noopener noreferrer">
                                    <Icon name="github" class="w-3 h-3" /> View Code
                                </a>
                            ) : (
                                <span class="project-status">Closed source</span>
                            )}
                        </div>
                    </article>
                ))
            }
        </div>

        {
            compactProjects.length > 0 && (
                <div class="compact-projects-wrap" data-accordion-group>
                    <div class="section-header-split compact-projects-header">
                        <div>
                            <p class="section-kicker">More stuff</p>
                            <!-- <h3 class="compact-projects-title">More projects, expanded only when needed.</h3> -->
                        </div>
                    </div>

                    <div class="compact-projects-list">
                        {compactProjects.map((project) => (
                            <details class="compact-project panel panel-muted">
                                <summary class="compact-project-summary">
                                    <div class="compact-project-main">
                                        <h4 class="compact-project-name">{project.title}</h4>
                                    </div>
                                    <span class="compact-project-toggle">
                                        <span>Details</span>
                                        <span class="compact-project-chevron" aria-hidden="true" />
                                    </span>
                                </summary>

                                <div class="compact-project-body">
                                    <div class="compact-project-body-inner">
                                        <p class="body-copy-sm">{project.description}</p>
                                        <div class="tag-row">
                                            {project.tags.map((tag) => (
                                                <span class="tag-pill">{tag}</span>
                                            ))}
                                        </div>
                                        <div class="project-links">
                                            {project.link && (
                                                <a href={project.link} class="link-inline" target="_blank" rel="noopener noreferrer">
                                                    <Icon name="external-link" class="w-3 h-3" /> Live Demo
                                                </a>
                                            )}
                                            {project.githubUrl ? (
                                                <a href={project.githubUrl} class="link-inline" target="_blank" rel="noopener noreferrer">
                                                    <Icon name="github" class="w-3 h-3" /> View Code
                                                </a>
                                            ) : (
                                                <span class="project-status">Closed source</span>
                                            )}
                                        </div>
                                    </div>
                                </div>
                            </details>
                        ))}
                    </div>
                </div>
            )
        }
    </div>
</section>

<script>
    const accordionGroups = document.querySelectorAll("[data-accordion-group]");

    accordionGroups.forEach((group) => {
        const items = Array.from(group.querySelectorAll("details.compact-project"));

        items.forEach((item) => {
            item.addEventListener("toggle", () => {
                if (!item.hasAttribute("open")) return;

                items.forEach((otherItem) => {
                    if (otherItem !== item) otherItem.removeAttribute("open");
                });
            });
        });
    });
</script>
