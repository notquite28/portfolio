---
interface Props {
  copyright?: string;
  year?: number;
}

const {
  copyright = 'Arnav Panigrahi',
  year = new Date().getFullYear()
} = Astro.props;
---

<footer class="px-[clamp(1.1rem,3vw,2rem)] pb-10 pt-2 text-white/60">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 border-t border-white/10 pt-6 text-sm md:flex-row md:items-center md:justify-between">
    <p>{copyright}</p>
    <p>© {year} · Built with Astro, Tailwind, and a preference for simple systems.</p>
  </div>
</footer>
