---
import Icon from '../ui/Icon.astro';

interface Props {
  copyright?: string;
  year?: number;
}

const { 
  copyright = "John Doe. All Rights Reserved.",
  year = new Date().getFullYear()
} = Astro.props;
---

<footer class="py-8 px-4 text-white text-center section-transition bg-gradient-to-r from-[--color-surface-2] to-[--color-surface]">
  <div class="max-w-4xl mx-auto">
    <p class="mb-4">© {year} {copyright}</p>
    <p class="text-white/90 flex items-center justify-center gap-1">
      Built with <Icon name="heart" class="w-4 h-4 text-red-500" /> and lots of coffee
    </p>
  </div>
</footer>
