---
interface ProofItem {
    value: string;
    label: string;
}

interface Props {
    name?: string;
    title?: string;
    intro?: string;
    proof?: ProofItem[];
}

const {
    name = "Arnav Panigrahi",
    title = "Software developer. Lifetime Learner",
    proof = [
        { value: "2.5+", label: "years shipping software" },
        { value: "60%", label: "faster agentic automation" },
        { value: "$20K", label: "annual savings delivered" },
    ],
} = Astro.props;
---

<section class="hero-shell hero-shell-first section-transition">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(17rem,0.65fr)] lg:items-end xl:gap-16">
        <div class="hero-copy">
            <p class="section-kicker">Software Developer</p>
            <h1 class="hero-title">{name}</h1>
            <p class="hero-lead">{title}</p>

            <div class="hero-actions">
                <a href="#projects" class="contact-link hero-primary-link">View Work</a>
                <a href="#cta" class="hero-link">Get in touch</a>
            </div>
        </div>

        <aside class="hero-rail">
            <p class="panel-label">Snapshot</p>
            <div class="hero-metrics">
                {
                    proof.map((item) => (
                        <div class="metric-item">
                            <span class="metric-value">{item.value}</span>
                            <span class="metric-label">{item.label}</span>
                        </div>
                    ))
                }
            </div>

            <div class="hero-notes">
                <div>
                    <span class="panel-meta">Focus</span>
                    <p>LLM systems, backend, retrieval, automation.</p>
                </div>
                <div>
                    <span class="panel-meta">Based in</span>
                    <p>California, US</p>
                </div>
            </div>
        </aside>
    </div>
</section>
