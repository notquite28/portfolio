---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links?: NavLink[];
}

const defaultLinks: NavLink[] = [
  { label: 'About', href: '#about' },
  { label: 'Skills', href: '#skills' },
  { label: 'Projects', href: '#projects' },
  { label: 'Contact', href: '#cta' },
];

const { links = defaultLinks } = Astro.props;
---

<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 opacity-0 -translate-y-full" id="nav">
  <div class="max-w-6xl mx-auto px-4 py-3">
    <div class="glass-container rounded-full px-6 py-2 flex items-center justify-between" data-glass-interactive data-glass-random>
      <div class="glass-filter"></div>
      <div class="glass-overlay"></div>
      <div class="glass-specular"></div>
      <div class="glass-content flex items-center justify-between w-full">
        <a href="#" class="text-xl text-white/80 hover:text-white transition-colors" aria-label="Home">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
          </svg>
        </a>
        
        <ul class="hidden md:flex items-center gap-6">
          {links.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-white/80 hover:text-white transition-colors duration-200 text-sm font-medium"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        
        <label 
          for="nav-toggle" 
          class="md:hidden text-white/80 hover:text-white transition-colors cursor-pointer"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6 nav-icon-menu" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg class="w-6 h-6 nav-icon-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </label>
      </div>
    </div>
    
    <input type="checkbox" id="nav-toggle" class="sr-only peer" />
    
    <div class="md:hidden hidden peer-checked:block mt-2 glass-container rounded-2xl p-4" data-glass-interactive data-glass-random>
      <div class="glass-filter"></div>
      <div class="glass-overlay"></div>
      <div class="glass-specular"></div>
      <div class="glass-content">
        <ul class="flex flex-col gap-4">
          {links.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="block text-white/80 hover:text-white transition-colors duration-200 text-center py-2"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</nav>

<style>
  #nav-toggle:checked ~ div .nav-icon-menu {
    display: none;
  }
  #nav-toggle:checked ~ div .nav-icon-close {
    display: block;
  }
  
  #nav-toggle:checked ~ div .glass-content a[href^="#"] {
    scroll-behavior: smooth;
  }
</style>

<script>
  const nav = document.getElementById('nav');
  
  window.addEventListener('scroll', () => {
    if (!nav) return;
    
    if (window.scrollY > 100) {
      nav.classList.add('opacity-100', 'translate-y-0');
      nav.classList.remove('opacity-0', '-translate-y-full');
    } else {
      nav.classList.remove('opacity-100', 'translate-y-0');
      nav.classList.add('opacity-0', '-translate-y-full');
    }
  });

  const navToggle = document.getElementById('nav-toggle');
  document.querySelectorAll('#nav-toggle ~ div .glass-content a[href^="#"]').forEach(link => {
    link.addEventListener('click', () => {
      if (navToggle) {
        (navToggle as HTMLInputElement).checked = false;
      }
    });
  });
</script>
