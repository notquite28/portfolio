---
import { buildUrl } from "../../utils/paths";

const modelUrl = buildUrl("koi.glb");
---

<div class="notfound-model-shell" data-notfound-model data-model-url={modelUrl} aria-hidden="true">
    <div class="notfound-model-fallback"></div>
</div>
<script is:inline type="module" src={buildUrl("js/notfound-model.js")}></script>

<style>
  .notfound-model-shell {
    position: relative;
    width: min(100%, 22rem);
    aspect-ratio: 1;
    overflow: visible;
    background: transparent;
    touch-action: none;
    user-select: none;
  }

    .notfound-model-shell canvas {
        display: block;
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 28px 36px rgba(0, 0, 0, 0.34));
    }

    .notfound-model-fallback {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: radial-gradient(circle at 50% 35%, rgba(139, 233, 253, 0.12), transparent 28%), radial-gradient(circle at 50% 75%, rgba(189, 147, 249, 0.14), transparent 38%);
    }
</style>
