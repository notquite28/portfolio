---
import { getBaseUrl } from '../../utils/paths';
import NotFoundModel from './NotFoundModel.astro';

const baseUrl = getBaseUrl();
---

<div class="min-h-screen flex flex-col items-center justify-center p-8 text-center relative">
  <p class="section-kicker">404</p>
  <h1 class="section-title mx-auto max-w-none">Page not found.</h1>
  <p class="mt-4 text-lg text-white/78">The page you were looking for does not exist.</p>

  <div class="mx-auto my-8 w-full max-w-[22rem]">
    <NotFoundModel />
  </div>

  <div class="flex justify-center">
    <a href={baseUrl} class="contact-link" title="Return to home">Return home</a>
  </div>
</div>
