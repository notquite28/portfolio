---
import '../../styles/global.css';
import Oneko from '../../components/ui/Oneko.astro';
import { buildUrl } from '../../utils/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Arnav Panigrahi | Backend & AI/ML Software Developer',
  description = 'Software developer focused on backend systems, full-stack applications, and AI/ML pipelines. M.S. Computer Science, UC Riverside.',
  image = 'jelly.webp',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://arnavpanigrahi.com/');
const socialImageURL = new URL(buildUrl(image), Astro.site ?? 'https://arnavpanigrahi.com/').toString();
const isProd = import.meta.env.PROD;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Arnav Panigrahi" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href={buildUrl('favicon.svg')} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:wght@300;400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body class="folio-theme">
  <a href="#main-content" class="skip-link">Skip to content</a>
  <main id="main-content">
    <slot />
  </main>
  <Oneko position="bottom-right" />
  {isProd && <script is:inline defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "d82e640ddac84498b86f3aef468f7107"}'></script>}
</body>
</html>

<style is:global>
  .folio-theme {
    --c-surface: #100f0e;
    --c-elevated: #1b1916;
    --c-ink: #eee7dc;
    --c-body: #b7aea4;
    --c-muted: #91877d;
    --c-rule: #2f2924;
    --c-accent: #d87556;
    --c-accent-soft: #f0b084;
    --c-paper: #1b1916;
    --c-card-border: #3a312a;
    --c-aura: #8f3e2c;
    --shadow-soft: 0 1.5rem 4rem rgba(0, 0, 0, 0.22);

    --font-serif: "Newsreader", Georgia, serif;
    --font-sans: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);

    position: relative;
    isolation: isolate;
    background:
      radial-gradient(circle at 18% 0%, color-mix(in oklch, var(--c-aura) 18%, transparent), transparent 30rem),
      radial-gradient(circle at 88% 12%, rgba(240, 176, 132, 0.08), transparent 28rem),
      linear-gradient(180deg, #151311 0%, var(--c-surface) 32rem);
    color: var(--c-ink);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  .folio-theme::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(238, 231, 220, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(238, 231, 220, 0.018) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.72), transparent 74%);
  }

  .folio-theme canvas#boidCanvas {
    display: none;
  }

  ::selection {
    background: rgba(212, 102, 74, 0.25);
    color: var(--c-ink);
  }

  :focus-visible {
    outline: 1px solid var(--c-accent-soft);
    outline-offset: 4px;
  }

  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-link:focus {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 100;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    background: var(--c-elevated);
    color: var(--c-ink);
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
    text-decoration: none;
    font-size: 0.875rem;
    border-radius: 0.25rem;
  }

  .folio-theme .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 720ms var(--ease-expo), transform 720ms var(--ease-expo);
    will-change: transform, opacity;
  }

  .folio-theme .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .folio-theme .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const elements = document.querySelectorAll('.reveal');

  if (prefersReducedMotion) {
    elements.forEach((el) => el.classList.add('is-visible'));
  } else if (!('IntersectionObserver' in window)) {
    elements.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          currentObserver.unobserve(entry.target);
        });
      },
      {
        threshold: 0.14,
        rootMargin: '0px 0px -8% 0px',
      }
    );

    elements.forEach((el) => observer.observe(el));
  }
</script>
