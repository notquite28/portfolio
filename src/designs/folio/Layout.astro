---
import '../../styles/global.css';
import Oneko from '../../components/ui/Oneko.astro';
import { buildUrl } from '../../utils/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Arnav Panigrahi | Backend & AI/ML Software Developer',
  description = 'Software developer focused on backend systems, full-stack applications, and AI/ML pipelines. M.S. Computer Science, UC Riverside.',
  image = 'jelly.webp',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://arnavpanigrahi.com/');
const socialImageURL = new URL(buildUrl(image), Astro.site ?? 'https://arnavpanigrahi.com/').toString();
const isProd = import.meta.env.PROD;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Arnav Panigrahi" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href={buildUrl('favicon.svg')} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    rel="stylesheet"
  />
</head>
<body class="folio-theme">
  <a href="#main-content" class="skip-link">Skip to content</a>

  <div class="noise-overlay" aria-hidden="true"></div>
  <div class="cursor-glow" aria-hidden="true"></div>

  <main id="main-content">
    <slot />
  </main>

  <Oneko position="bottom-right" />

  {isProd && <script is:inline defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "d82e640ddac84498b86f3aef468f7107"}'></script>}
</body>
</html>

<style is:global>
  .folio-theme {
    --c-surface: #0d0c0b;
    --c-elevated: #161412;
    --c-ink: #f0ebe4;
    --c-body: #b0a89c;
    --c-muted: #8a8076;
    --c-rule: #2a2420;
    --c-accent: #c97b5a;
    --c-accent-soft: #e4b894;
    --c-paper: #161412;
    --c-card-border: #332b26;
    --c-aura: #7a3a28;
    --c-gold: #c9a86c;
    --shadow-soft: 0 1.5rem 4rem rgba(0, 0, 0, 0.28);

    --font-serif: "Cormorant Garamond", Georgia, serif;
    --font-body: "Source Serif 4", Georgia, serif;
    --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);

    position: relative;
    isolation: isolate;
    background:
      radial-gradient(circle at 12% 0%, color-mix(in oklch, var(--c-aura) 14%, transparent), transparent 40rem),
      radial-gradient(circle at 92% 8%, rgba(201, 168, 108, 0.06), transparent 32rem),
      radial-gradient(circle at 50% 100%, rgba(122, 58, 40, 0.08), transparent 50rem),
      linear-gradient(180deg, #12100e 0%, var(--c-surface) 36rem);
    color: var(--c-ink);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  .folio-theme::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(240, 235, 228, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 235, 228, 0.015) 1px, transparent 1px);
    background-size: 5rem 5rem;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), transparent 80%);
  }

  .noise-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 200px 200px;
  }

  .cursor-glow {
    position: fixed;
    width: 40rem;
    height: 40rem;
    margin-left: -20rem;
    margin-top: -20rem;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    background: radial-gradient(circle, rgba(201, 123, 90, 0.06) 0%, transparent 70%);
    transform: translate3d(var(--cursor-x, 0px), var(--cursor-y, 0px), 0);
    left: 0;
    top: 0;
    will-change: transform;
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .cursor-glow {
      opacity: 1;
    }
  }

  .folio-theme canvas#boidCanvas {
    display: none;
  }

  ::selection {
    background: rgba(201, 123, 90, 0.22);
    color: var(--c-ink);
  }

  :focus-visible {
    outline: 1px solid var(--c-accent-soft);
    outline-offset: 4px;
  }

  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-link:focus {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 100;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    background: var(--c-elevated);
    color: var(--c-ink);
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
    text-decoration: none;
    font-size: 0.875rem;
    border-radius: 0.25rem;
  }

  .folio-theme .reveal {
    opacity: 0;
    transform: translateY(28px);
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .folio-theme .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .cursor-glow {
      display: none;
    }
    .noise-overlay {
      display: none;
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Smooth scroll — wired into GSAP ticker, no separate RAF loop
  let lenis: Lenis | null = null;
  if (!prefersReducedMotion) {
    lenis = new Lenis({
      duration: 0.85,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      smoothWheel: true,
      syncTouch: true,
      anchors: true,
    });

    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => {
      lenis!.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);
  }

  // Cursor glow — transform-only (no layout thrashing), pauses RAF when idle
  const cursorGlow = document.querySelector('.cursor-glow') as HTMLElement | null;
  let cursorRafId: number | null = null;
  if (cursorGlow && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let currentX = mouseX;
    let currentY = mouseY;
    let lastMouseMove = performance.now();
    let isCursorActive = false;

    const onMouseMove = (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      lastMouseMove = performance.now();
      if (!isCursorActive) {
        isCursorActive = true;
        animateCursor();
      }
    };
    document.addEventListener('mousemove', onMouseMove);

    function animateCursor() {
      const now = performance.now();
      if (now - lastMouseMove > 100) {
        isCursorActive = false;
        return;
      }
      currentX += (mouseX - currentX) * 0.08;
      currentY += (mouseY - currentY) * 0.08;
      cursorGlow!.style.setProperty('--cursor-x', `${currentX}px`);
      cursorGlow!.style.setProperty('--cursor-y', `${currentY}px`);
      cursorRafId = requestAnimationFrame(animateCursor);
    }
    cursorRafId = requestAnimationFrame(animateCursor);
  }

  // Enhanced reveal system with GSAP ScrollTrigger
  const createdTweens: gsap.core.Tween[] = [];

  if (!prefersReducedMotion) {
    const revealElements = document.querySelectorAll('.reveal');
    revealElements.forEach((el) => {
      createdTweens.push(
        gsap.fromTo(
          el,
          { y: 32, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.9,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              end: 'top 55%',
              toggleActions: 'play none none none',
            },
          }
        )
      );
    });

    // Staggered group reveals
    const revealGroups = document.querySelectorAll('.reveal-group');
    revealGroups.forEach((group) => {
      const children = group.querySelectorAll('.reveal-child');
      createdTweens.push(
        gsap.fromTo(
          children,
          { y: 28, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.8,
            ease: 'power3.out',
            stagger: 0.1,
            scrollTrigger: {
              trigger: group,
              start: 'top 85%',
              toggleActions: 'play none none none',
            },
          }
        )
      );
    });

    // Parallax elements
    const parallaxElements = document.querySelectorAll('[data-parallax]');
    parallaxElements.forEach((el) => {
      const speed = parseFloat(el.getAttribute('data-parallax') ?? '0.15');
      createdTweens.push(
        gsap.to(el, {
          y: () => speed * 100,
          ease: 'none',
          scrollTrigger: {
            trigger: el,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        })
      );
    });
  } else {
    document.querySelectorAll('.reveal, .reveal-child').forEach((el) => {
      (el as HTMLElement).style.opacity = '1';
      (el as HTMLElement).style.transform = 'none';
    });
  }

  // Cleanup on page unload to prevent HMR leaks
  window.addEventListener('beforeunload', () => {
    createdTweens.forEach((t) => {
      t.scrollTrigger?.kill();
      t.kill();
    });
    if (lenis) {
      lenis.destroy();
    }
    if (cursorRafId) {
      cancelAnimationFrame(cursorRafId);
    }
  });
</script>
