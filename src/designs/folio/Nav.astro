---
import { profile } from '../../data/content';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/posts/', label: 'Posts' },
  { href: '/#contact', label: 'Contact' },
  { href: profile.resume, label: 'Resume' },
];
---

<nav class="nav is-top" aria-label="Primary navigation" data-nav>
  <div class="nav-inner">
    <a href="/" class="nav-brand">{profile.name}</a>
    <div class="nav-links">
      {links.map((link) => (
        <a href={link.href} class={`nav-link${link.label === 'Resume' ? ' nav-link-accent' : ''}`} data-nav-link {...link.label === 'Resume' ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>{link.label}</a>
      ))}
    </div>
    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="primary-mobile-menu">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </div>
  <div class="nav-mobile" id="primary-mobile-menu" aria-hidden="true">
    {links.map((link) => (
      <a href={link.href} class={`nav-mobile-link${link.label === 'Resume' ? ' nav-mobile-link-accent' : ''}`} data-nav-link {...link.label === 'Resume' ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>{link.label}</a>
    ))}
  </div>
</nav>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const mobile = document.querySelector('.nav-mobile');
  const nav = document.querySelector('[data-nav]') as HTMLElement | null;

  if (toggle instanceof HTMLButtonElement && mobile instanceof HTMLElement) {
    const closeMenu = ({ restoreFocus = false } = {}) => {
      toggle.setAttribute('aria-expanded', 'false');
      mobile.setAttribute('aria-hidden', 'true');
      mobile.classList.remove('is-open');
      if (restoreFocus) toggle.focus();
    };

    const setMenuOpen = (isOpen: boolean) => {
      toggle.setAttribute('aria-expanded', String(isOpen));
      mobile.setAttribute('aria-hidden', String(!isOpen));
      mobile.classList.toggle('is-open', isOpen);
    };

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!expanded);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu({ restoreFocus: true });
      }
    });

    mobile.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMenu());
    });
  }

  // Active section tracking
  const sectionIds = ['about', 'experience', 'skills', 'work', 'contact'];
  const navLinks = document.querySelectorAll<HTMLElement>('[data-nav-link]');

  const updateActiveLink = (id: string | null) => {
    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (href === `#${id}` || href === `/#${id}`) {
        link.classList.add('is-active');
      } else {
        link.classList.remove('is-active');
      }
    });
  };

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          updateActiveLink(entry.target.id);
        }
      }
    },
    { rootMargin: '-20% 0px -60% 0px' }
  );

  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) sectionObserver.observe(el);
  });

  // Hide/show on scroll
  if (nav) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lastScroll = window.scrollY;
    let ticking = false;
    const threshold = 80;

    const syncNavState = (currentScroll: number) => {
      if (currentScroll < threshold) {
        nav.classList.remove('is-hidden');
        nav.classList.add('is-top');
      } else if (currentScroll > lastScroll && currentScroll > threshold * 2) {
        nav.classList.add('is-hidden');
        nav.classList.remove('is-top');
      } else if (currentScroll < lastScroll) {
        nav.classList.remove('is-hidden');
        nav.classList.remove('is-top');
      }
      lastScroll = currentScroll;
    };

    if (prefersReducedMotion) {
      nav.classList.remove('is-hidden');
      nav.classList.toggle('is-top', window.scrollY < threshold);
    } else {
      syncNavState(window.scrollY);

      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            syncNavState(window.scrollY);
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    }
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0.85rem;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 clamp(0.75rem, 2vw, 1.25rem);
    pointer-events: none;
    transform: translateY(0);
    transition: transform 400ms var(--ease-expo);
  }

  .nav.is-hidden {
    transform: translateY(calc(-100% - 1.25rem));
  }

  .nav-inner {
    pointer-events: auto;
    width: min(100%, 48rem);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.7rem 0.55rem 1.05rem;
    border: 1px solid color-mix(in oklch, var(--c-water-mint) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in oklch, var(--c-pond-850) 78%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklch, var(--c-cream) 8%, transparent),
      0 0.75rem 1.75rem color-mix(in oklch, var(--c-pond-900) 42%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    transition:
      background 400ms var(--ease-expo),
      border-color 400ms var(--ease-expo),
      box-shadow 400ms var(--ease-expo);
  }

  .nav:not(.is-top) .nav-inner {
    background: color-mix(in oklch, var(--c-pond-850) 92%, transparent);
    border-color: color-mix(in oklch, var(--c-water-mint) 26%, transparent);
  }

  .nav-brand {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 300ms var(--ease-expo);
  }

  .nav-brand:hover {
    color: var(--c-gold);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--c-muted);
    text-decoration: none;
    position: relative;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    transition:
      color 300ms var(--ease-expo),
      background 300ms var(--ease-expo);
    letter-spacing: 0.01em;
  }

  .nav-link:hover {
    color: var(--c-accent-soft);
    background: color-mix(in oklch, var(--c-water-mint) 8%, transparent);
  }

  .nav-link.is-active {
    color: var(--c-ink);
    background: color-mix(in oklch, var(--c-water-mint) 12%, transparent);
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: color-mix(in oklch, var(--c-water-mint) 8%, transparent);
    border: 1px solid color-mix(in oklch, var(--c-water-mint) 16%, transparent);
    border-radius: 999px;
    cursor: pointer;
    padding: 0.55rem 0.65rem;
  }

  .nav-toggle-bar {
    display: block;
    width: 18px;
    height: 1.5px;
    background-color: var(--c-ink);
    transition: transform 300ms var(--ease-expo), opacity 300ms ease;
  }

  .nav-toggle-bar:nth-child(2) {
    transform-origin: center;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:first-child {
    transform: translateY(5px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:last-child {
    transform: translateY(-5px) rotate(-45deg);
  }

  .nav-mobile {
    pointer-events: auto;
    display: none;
    flex-direction: column;
    width: min(100%, 48rem);
    margin: 0.55rem auto 0;
    padding: 0.55rem;
    border: 1px solid color-mix(in oklch, var(--c-water-mint) 18%, transparent);
    border-radius: 1.25rem;
    background: color-mix(in oklch, var(--c-pond-850) 96%, black);
    box-shadow: 0 0.75rem 1.75rem color-mix(in oklch, var(--c-pond-900) 42%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
  }

  .nav-mobile.is-open {
    display: flex;
  }

  .nav-mobile-link {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--c-body);
    text-decoration: none;
    padding: 0.75rem 0.9rem;
    border-radius: 0.85rem;
    transition: color 200ms ease, background 200ms ease;
  }

  .nav-mobile-link:hover,
  .nav-mobile-link.is-active {
    color: var(--c-ink);
    background: color-mix(in oklch, var(--c-water-mint) 10%, transparent);
  }

  .nav-mobile-link.is-active {
    color: var(--c-accent-soft);
  }

  .nav-link-accent,
  .nav-mobile-link-accent {
    color: var(--c-accent);
  }

  .nav-link-accent:hover,
  .nav-mobile-link-accent:hover {
    color: var(--c-gold);
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }

    .nav-toggle {
      display: none;
    }

    .nav-mobile {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav { transition: none; }
    .nav-mobile { transition: none; }
  }
</style>
