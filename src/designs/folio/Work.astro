---
import { projects } from '../../data/content';

const featured = projects[0];
if (!featured) throw new Error("No projects found");
const secondary = projects.slice(1, 4);
const collapsible = projects.slice(4);
---

<section id="work" class="work reveal">
  <div class="work-inner">
    <p class="kicker">Selected Work</p>
    <h2 class="section-title">Projects</h2>

    <div class="featured-card">
      <div class="featured-content">
        <h3 class="featured-title">{featured.title}</h3>
        <p class="featured-desc">{featured.description}</p>
        {featured.highlights && featured.highlights.length > 0 && (
          <ul class="featured-highlights">
            {featured.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        )}
      </div>
      <div class="featured-meta">
        <div class="tags">
          {featured.tags.map((tag, i) => (
            <>
              {i > 0 && <span class="tag-sep"> / </span>}
              <span class="tag">{tag}</span>
            </>
          ))}
        </div>
        {featured.githubUrl && (
          <a href={featured.githubUrl} class="project-link" target="_blank" rel="noopener noreferrer">
            View on GitHub
          </a>
        )}
      </div>
    </div>

    <div class="secondary-list">
      {secondary.map((project) => (
        <div class="secondary-row">
          <div class="secondary-main">
            <h3 class="secondary-title">{project.title}</h3>
            <p class="secondary-desc">{project.description}</p>
          </div>
          <div class="secondary-side">
            <div class="tags">
              {(project.compactTags ?? project.tags).map((tag, i) => (
                <>
                  {i > 0 && <span class="tag-sep"> / </span>}
                  <span class="tag">{tag}</span>
                </>
              ))}
            </div>
            {project.githubUrl && (
              <a href={project.githubUrl} class="project-link" target="_blank" rel="noopener noreferrer">
                View on GitHub
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    {collapsible.length > 0 && (
      <div class="collapsible-list">
        {collapsible.map((project) => (
          <details class="collapsible-item">
            <summary class="collapsible-summary">
              <span class="collapsible-summary-main">
                <span class="collapsible-name">{project.title}</span>
                <span class="collapsible-tags">
                  {(project.compactTags ?? project.tags).slice(0, 3).map((tag, i) => (
                    <>
                      {i > 0 && <span class="tag-sep"> / </span>}
                      <span>{tag}</span>
                    </>
                  ))}
                </span>
              </span>
              <span class="collapsible-toggle">
                <span class="chevron"></span>
              </span>
            </summary>
            <div class="collapsible-body">
              <p class="collapsible-desc">{project.description}</p>
              <div class="tags">
                {(project.compactTags ?? project.tags).map((tag, i) => (
                  <>
                    {i > 0 && <span class="tag-sep"> / </span>}
                    <span class="tag">{tag}</span>
                  </>
                ))}
              </div>
              {project.githubUrl && (
                <a href={project.githubUrl} class="project-link" target="_blank" rel="noopener noreferrer">
                  View on GitHub
                </a>
              )}
            </div>
          </details>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .work {
    padding: clamp(5rem, 10vw, 8rem) clamp(1.5rem, 4vw, 3rem);
  }

  .work-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    margin-bottom: 2.5rem;
  }

  .featured-card {
    position: relative;
    overflow: hidden;
    background-color: var(--c-paper);
    border-radius: 1rem;
    border: 1px solid var(--c-card-border);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    gap: 2rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-soft);
    transition:
      border-color 520ms var(--ease-expo),
      transform 520ms var(--ease-expo),
      box-shadow 520ms var(--ease-expo);
  }

  .featured-card:hover {
    border-color: color-mix(in oklch, var(--c-accent) 38%, var(--c-card-border));
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.28);
    transform: translateY(-4px);
  }

  .featured-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.7rem, 2.8vw, 2.35rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-ink);
  }

  .featured-desc {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.72;
    color: var(--c-body);
    max-width: 44rem;
  }

  .featured-highlights {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .featured-highlights li {
    position: relative;
    padding-left: 1rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--c-body);
  }

  .featured-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--c-accent);
  }

  .featured-meta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: flex-start;
  }

  .tags {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--c-muted);
  }

  .tag-sep {
    margin: 0 0.15em;
    color: var(--c-rule);
  }

  .project-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--c-accent);
    text-decoration: none;
    position: relative;
    padding-bottom: 1px;
    transition: color 280ms var(--ease-expo);
  }

  .project-link:hover {
    color: var(--c-accent-soft);
  }

  .project-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--c-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 300ms var(--ease-expo);
  }

  .project-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .secondary-list {
    border-top: 1px solid var(--c-rule);
  }

  .secondary-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--c-rule);
    transition:
      border-color 360ms var(--ease-expo),
      padding-left 360ms var(--ease-expo),
      padding-right 360ms var(--ease-expo);
  }

  .secondary-row::before {
    content: '';
    position: absolute;
    inset: 0 -1rem;
    z-index: -1;
    border-radius: 0.75rem;
    background: rgba(238, 231, 220, 0.028);
    opacity: 0;
    transform: scaleX(0.985);
    transition:
      opacity 360ms var(--ease-expo),
      transform 360ms var(--ease-expo);
  }

  .secondary-row:hover {
    border-color: color-mix(in oklch, var(--c-accent) 34%, var(--c-rule));
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  .secondary-row:hover::before {
    opacity: 1;
    transform: scaleX(1);
  }

  .secondary-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--c-ink);
    margin-bottom: 0.5rem;
  }

  .secondary-desc {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--c-body);
  }

  .secondary-side {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .collapsible-list {
    margin-top: 1.5rem;
  }

  .collapsible-item {
    border-top: 1px solid var(--c-rule);
    transition: border-color 280ms var(--ease-expo);
  }

  .collapsible-item:hover {
    border-color: color-mix(in oklch, var(--c-accent) 26%, var(--c-rule));
  }

  .collapsible-item:first-child {
    border-top: 0;
  }

  .collapsible-item:last-child {
    border-bottom: 1px solid var(--c-rule);
  }

  .collapsible-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--c-ink);
    transition: color 200ms ease;
  }

  .collapsible-summary:hover .collapsible-tags {
    color: var(--c-body);
  }

  .collapsible-summary-main {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    min-width: 0;
  }

  .collapsible-name {
    flex: 0 0 auto;
  }

  .collapsible-tags {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--c-muted);
  }

  .collapsible-summary::-webkit-details-marker {
    display: none;
  }

  .collapsible-summary:hover {
    color: var(--c-accent);
  }

  .collapsible-toggle {
    display: inline-flex;
    align-items: center;
  }

  .chevron {
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transition:
      transform 280ms var(--ease-expo),
      color 280ms var(--ease-expo);
  }

  .collapsible-item[open] .chevron {
    transform: rotate(225deg) translateY(1px);
  }

  .collapsible-body {
    padding: 0 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .collapsible-desc {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--c-body);
    max-width: 44rem;
  }

  @media (min-width: 640px) {
    .secondary-row {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 2rem;
    }
  }

  @media (max-width: 520px) {
    .collapsible-summary-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }

  @media (min-width: 1024px) {
    .featured-card {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: start;
    }
  }
</style>
