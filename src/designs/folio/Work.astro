---
import { projects } from '../../data/content';
import { buildUrl } from '../../utils/paths';

const secondary = projects.slice(0, 4);
const collapsible = projects.slice(4);

const projectImages: Record<string, string> = {
  'bedtime.ai': 'bedtime.ai.png',
  'Sabi Agent': 'sabi-agent.png',
  'Abliteration for LFM2.5': 'abliteration.png',
  'Nier Archive': 'nier.png',
  'Yomiji': 'kanji.png',
};

const projectThemes = [
  'theme-sunset',
  'theme-deep',
  'theme-forest',
  'theme-bloom',
  'theme-sage',
  'theme-indigo',
  'theme-bronze',
];

function hasImage(title: string) {
  return projectImages[title] !== undefined;
}

function getImage(title: string) {
  return buildUrl(projectImages[title] ?? '');
}

function getTheme(title: string, fallbackIndex: number) {
  if (hasImage(title)) return '';
  return projectThemes[fallbackIndex] ?? '';
}
---

<section id="work" class="work">
  <div class="work-inner">
    <p class="kicker reveal">Selected Work</p>
    <h2 class="section-title reveal">Projects</h2>

    <div class="project-grid">
      {secondary.map((project, i) => (
        <div class="project-card reveal" data-tilt>
          <div class={`project-visual ${getTheme(project.title, i)}`} aria-hidden="true">
            {hasImage(project.title) ? (
              <img
                src={getImage(project.title)}
                alt={`${project.title} preview`}
                class="project-image"
                loading="lazy"
              />
            ) : (
              <span class="project-monogram" aria-hidden="true">
                {project.title.charAt(0)}
              </span>
            )}
          </div>
          <div class="project-content">
            <h3 class="project-title">{project.title}</h3>
            {project.subtitle && <p class="project-subtitle">{project.subtitle}</p>}
            {project.highlights && project.highlights.length > 0 && (
              <ul class="project-highlights">
                {project.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            <div class="project-meta">
              <div class="tags">
                {(project.compactTags ?? project.tags).map((tag, j) => (
                  <>
                    {j > 0 && <span class="tag-sep"> / </span>}
                    <span class="tag">{tag}</span>
                  </>
                ))}
              </div>
              {project.githubUrl && (
                <a href={project.githubUrl} class="project-link" target="_blank" rel="noopener noreferrer">
                  View on GitHub
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    {collapsible.length > 0 && (
      <div class="collapsible-list-wrapper">
        <p class="kicker collapsible-kicker reveal">Earlier Work</p>
      <div class="collapsible-list">
        {collapsible.map((project) => (
          <div class="collapsible-item reveal" data-collapsible>
            <div class="collapsible-summary" role="button" tabindex="0" aria-expanded="false">
              <span class="collapsible-summary-main">
                <span class="collapsible-name">{project.title}</span>
                <span class="collapsible-tags">
                  {(project.compactTags ?? project.tags).slice(0, 3).map((tag, j) => (
                    <>
                      {j > 0 && <span class="tag-sep"> / </span>}
                      <span>{tag}</span>
                    </>
                  ))}
                </span>
              </span>
              <span class="collapsible-toggle">
                <span class="chevron"></span>
              </span>
            </div>
            <div class="collapsible-body" aria-hidden="true" inert>
              <div class="collapsible-body-inner">
                <p class="collapsible-desc">{project.description}</p>
                <div class="tags">
                  {(project.compactTags ?? project.tags).map((tag, j) => (
                    <>
                      {j > 0 && <span class="tag-sep"> / </span>}
                      <span class="tag">{tag}</span>
                    </>
                  ))}
                </div>
                {project.githubUrl && (
                  <a href={project.githubUrl} class="project-link" target="_blank" rel="noopener noreferrer">
                    View on GitHub
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
      </div>
    )}
  </div>
</section>

<script>
  import gsap from 'gsap';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Tilt effect on cards
  const tiltControllers: AbortController[] = [];
  if (!prefersReducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const tiltCards = document.querySelectorAll('[data-tilt]');
    tiltCards.forEach((card) => {
      const controller = new AbortController();
      tiltControllers.push(controller);

      const quickRotateY = gsap.quickTo(card, 'rotateY', { duration: 0.35, ease: 'power2.out' });
      const quickRotateX = gsap.quickTo(card, 'rotateX', { duration: 0.35, ease: 'power2.out' });

      const onMouseMove = (e: Event) => {
        const me = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = (me.clientX - rect.left) / rect.width - 0.5;
        const y = (me.clientY - rect.top) / rect.height - 0.5;

        quickRotateY(x * 2.5);
        quickRotateX(-y * 2.5);

      };

      const onMouseLeave = () => {
        quickRotateY(0);
        quickRotateX(0);
      };

      card.addEventListener('mousemove', onMouseMove, { signal: controller.signal });
      card.addEventListener('mouseleave', onMouseLeave, { signal: controller.signal });
    });
  }

  // CSS grid-based collapsible transitions: no scrollHeight reads or height tweens.
  const collapsibleControllers: AbortController[] = [];
  const collapsibles = document.querySelectorAll('[data-collapsible]');
  collapsibles.forEach((item) => {
    const controller = new AbortController();
    collapsibleControllers.push(controller);
    const summary = item.querySelector('.collapsible-summary') as HTMLElement | null;
    const body = item.querySelector('.collapsible-body') as HTMLElement | null;
    if (!summary || !body) return;

    const setOpen = (isOpen: boolean) => {
      item.classList.toggle('is-open', isOpen);
      summary.setAttribute('aria-expanded', String(isOpen));
      body.setAttribute('aria-hidden', String(!isOpen));
      body.toggleAttribute('inert', !isOpen);
    };

    const toggle = () => setOpen(!item.classList.contains('is-open'));

    summary.addEventListener('click', toggle, { signal: controller.signal });
    summary.addEventListener('keydown', (e: Event) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        toggle();
      }
    }, { signal: controller.signal });
  });

</script>

<style>
  .work {
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 4vw, 3rem) clamp(6rem, 12vw, 10rem);
    position: relative;
  }

  .work-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-gold);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--c-ink);
    margin-bottom: 3rem;
  }

  /* Project grid — 4 equal cards */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .project-card {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 0%, color-mix(in oklch, var(--c-water-mint) 7%, transparent), transparent 14rem),
      linear-gradient(180deg, var(--c-paper), color-mix(in oklch, var(--c-pond-800) 82%, var(--c-surface)));
    border-radius: 1.25rem;
    border: 1px solid var(--c-card-border);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-soft);
    transition: border-color 600ms var(--ease-expo), background 600ms var(--ease-expo), box-shadow 600ms var(--ease-expo);
    perspective: 1000px;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .project-card:hover {
    border-color: color-mix(in oklch, var(--c-water-mint) 42%, var(--c-card-border));
    box-shadow: 0 0.75rem 1.75rem rgba(0, 0, 0, 0.3), 0 0 0 1px color-mix(in oklch, var(--c-koi-orange) 12%, transparent);
  }

  .project-visual {
    position: relative;
    min-height: 12rem;
    overflow: hidden;
  }

  .project-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }


  .project-monogram {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 300;
    color: color-mix(in oklch, var(--c-ink) 20%, transparent);
    pointer-events: none;
    user-select: none;
  }

  .project-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    flex: 1;
  }

  .project-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.4rem;
    line-height: 1.2;
    color: var(--c-ink);
  }

  .project-subtitle {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--c-accent-soft);
    margin-top: -0.4rem;
    letter-spacing: 0.02em;
  }

  .project-highlights {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project-highlights li {
    position: relative;
    padding-left: 1rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--c-body);
  }

  .project-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--c-proof);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-rule);
  }

  /* Theme gradients — fallback for projects without images */
  .theme-sunset {
    background: linear-gradient(135deg, #3d1f16 0%, #5a2e1e 30%, #7a3e28 60%, #a05030 100%);
  }
  .theme-deep {
    background: linear-gradient(135deg, #1a1628 0%, #252040 40%, #302858 70%, #1e1a35 100%);
  }
  .theme-forest {
    background: linear-gradient(135deg, #0f1f1a 0%, #1a3528 35%, #244535 65%, #183028 100%);
  }
  .theme-bloom {
    background: linear-gradient(135deg, #2a1820 0%, #3d2530 35%, #4d3038 65%, #352028 100%);
  }
  .theme-sage {
    background: linear-gradient(135deg, #1a2018 0%, #253020 35%, #304028 65%, #1e281a 100%);
  }
  .theme-indigo {
    background: linear-gradient(135deg, #141a2e 0%, #1c2545 40%, #253058 70%, #1a1f38 100%);
  }
  .theme-bronze {
    background: linear-gradient(135deg, #2a1f14 0%, #3d2e1e 35%, #4d3a28 65%, #352618 100%);
  }

  /* Shared */
  .tags {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.8;
    color: var(--c-muted);
  }

  .tag-sep {
    margin: 0 0.15em;
    color: var(--c-rule);
  }

  .project-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--c-accent);
    text-decoration: none;
    position: relative;
    padding-bottom: 1px;
    transition: color 300ms var(--ease-expo);
    align-self: flex-start;
  }

  .project-link:hover {
    color: var(--c-gold);
  }

  .project-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--c-gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 400ms var(--ease-expo);
  }

  .project-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Collapsible */
  .collapsible-list-wrapper {
    margin-top: 2.5rem;
  }

  .collapsible-kicker {
    color: var(--c-accent-soft);
    margin-bottom: 1rem;
  }

  .collapsible-list {
    border-top: 1px solid var(--c-rule);
  }

  .collapsible-item {
    border-bottom: 1px solid var(--c-rule);
    transition: border-color 300ms var(--ease-expo);
  }

  .collapsible-item:hover {
    border-color: color-mix(in oklch, var(--c-water-mint) 34%, var(--c-rule));
    background: color-mix(in oklch, var(--c-water-mint) 6%, transparent);
  }

  .collapsible-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--c-ink);
    transition: color 300ms ease;
    user-select: none;
    outline: none;
  }

  .collapsible-summary:focus-visible {
    outline: 1px solid var(--c-accent-soft);
    outline-offset: 4px;
    color: var(--c-gold);
  }

  .collapsible-summary-main {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    min-width: 0;
  }

  .collapsible-name {
    flex: 0 0 auto;
  }

  .collapsible-tags {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--c-muted);
  }

  .collapsible-summary:hover {
    color: var(--c-accent-soft);
  }

  .collapsible-toggle {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .chevron {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transition: transform 350ms var(--ease-expo);
    opacity: 0.6;
  }

  .collapsible-item:hover .chevron {
    opacity: 1;
  }

  .collapsible-item.is-open .chevron {
    transform: rotate(225deg) translateY(1px);
  }

  .collapsible-body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    pointer-events: none;
    transition:
      grid-template-rows 300ms var(--ease-out),
      opacity 200ms ease;
  }

  .collapsible-body-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 0;
  }

  .collapsible-item.is-open .collapsible-body {
    grid-template-rows: 1fr;
    opacity: 1;
    pointer-events: auto;
  }

  .collapsible-item.is-open .collapsible-body-inner {
    padding-bottom: 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .collapsible-body,
    .chevron {
      transition: none;
    }
  }

  .collapsible-desc {
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--c-body);
    max-width: 44rem;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .project-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .project-visual {
      min-height: 10rem;
    }
  }

  @media (max-width: 520px) {
    .collapsible-summary-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
