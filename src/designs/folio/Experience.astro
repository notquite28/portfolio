---
import { experiences } from '../../data/content';
---

<section id="experience" class="experience">
  <div class="experience-inner">
    <p class="kicker reveal">Experience</p>
    <h2 class="section-title reveal">Where I've worked.</h2>
    <div class="timeline">
      <div class="timeline-line" aria-hidden="true">
        <div class="timeline-line-fill"></div>
      </div>
      <div class="experience-list">
        {experiences.map((exp) => (
          <div class="experience-item" data-timeline-item>
            <div class="timeline-dot" aria-hidden="true"></div>
            <div class="experience-card">
              <div class="experience-header">
                <div class="experience-role">
                  <h3 class="experience-title">{exp.title}</h3>
                  <span class="experience-company">{exp.company}</span>
                </div>
                <div class="experience-meta">
                  <span class="experience-location">{exp.location}</span>
                  <span class="experience-period">{exp.period}</span>
                </div>
              </div>
              <ul class="experience-bullets">
                {exp.bullets.map((bullet) => {
                  const commaIdx = bullet.indexOf(', ');
                  const lead = commaIdx >= 0 ? bullet.slice(0, commaIdx + 1) : null;
                  const rest = commaIdx >= 0 ? bullet.slice(commaIdx + 1) : bullet;
                  return (
                    <li class="experience-bullet">
                      {lead ? <><strong>{lead}</strong> {rest}</> : bullet}
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    ScrollTrigger.matchMedia({
      "(min-width: 768px)": function () {
        const triggers: ScrollTrigger[] = [];

        // Line-fill: explicit create (uses scrub — cannot batch)
        triggers.push(ScrollTrigger.create({
          trigger: ".timeline",
          start: "top 75%",
          end: "bottom 60%",
          scrub: 0.5,
          animation: gsap.fromTo(".timeline-line-fill", { scaleY: 0 }, { scaleY: 1, ease: "none" }),
        }));

        // Card triggers: slide-in from left
        document.querySelectorAll(".experience-card").forEach((card) => {
          triggers.push(ScrollTrigger.create({
            trigger: card,
            start: "top 82%",
            once: true,
            animation: gsap.fromTo(card, { x: -18, opacity: 0 }, { x: 0, opacity: 1, duration: 0.55, ease: "power3.out" }),
          }));
        });

        // Dot triggers: scale pop
        document.querySelectorAll(".timeline-dot").forEach((dot) => {
          triggers.push(ScrollTrigger.create({
            trigger: dot,
            start: "top 80%",
            once: true,
            animation: gsap.fromTo(dot, { scale: 0.72, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.28, ease: "power3.out" }),
          }));
        });

        return function () { triggers.forEach((t) => t.kill()); };
      },
    });
  }
</script>

<style>
  .experience {
    padding: clamp(6rem, 12vw, 10rem) clamp(1.5rem, 4vw, 3rem);
    position: relative;
  }

  .experience-inner {
    max-width: 52rem;
    margin: 0 auto;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-gold);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--c-ink);
    margin-bottom: 3.5rem;
  }

  .timeline {
    position: relative;
  }

  .timeline-line {
    position: absolute;
    left: 0.75rem;
    top: 0.5rem;
    bottom: 0;
    width: 1px;
    background: color-mix(in oklch, var(--c-water-mint) 24%, transparent);
  }

  .timeline-line-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--c-water-mint), var(--c-koi-gold));
    transform-origin: top;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-left: 2rem;
  }

  .experience-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .timeline-dot {
    position: absolute;
    left: -1.25rem;
    top: 0.65rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-water-mint);
    box-shadow: 0 0 0 4px var(--c-surface), 0 0 0 5px color-mix(in oklch, var(--c-koi-gold) 70%, var(--c-water-mint));
    transform: translateX(-3.5px);
  }

  .experience-card {
    position: relative;
    padding: 0.25rem 0;
    transition: transform 400ms var(--ease-expo);
  }

  .experience-card:hover {
    transform: translateX(0.3rem);
  }

  .experience-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .experience-role {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .experience-title {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--c-ink);
    margin: 0;
    transition: color 300ms var(--ease-expo);
  }

  .experience-card:hover .experience-title {
    color: var(--c-gold);
  }

  .experience-company {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--c-body);
  }

  .experience-meta {
    display: flex;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--c-muted);
    letter-spacing: 0.02em;
  }

  .experience-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .experience-bullet {
    position: relative;
    padding-left: 1rem;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--c-body);
  }

  .experience-bullet strong {
    color: var(--c-ink);
    font-weight: 500;
  }

  .experience-bullet::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--c-proof);
  }

  @media (min-width: 640px) {
    .experience-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }
</style>
