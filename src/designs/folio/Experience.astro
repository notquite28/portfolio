---
import { experiences } from '../../data/content';
---

<section id="experience" class="experience reveal">
  <div class="experience-inner">
    <p class="kicker">Experience</p>
    <h2 class="section-title">Where I've worked.</h2>
    <div class="experience-list">
      {experiences.map((exp, i) => (
        <div class="experience-item">
          <div class="experience-header">
            <div class="experience-role">
              <h3 class="experience-title">{exp.title}</h3>
              <span class="experience-company">{exp.company}</span>
            </div>
            <div class="experience-meta">
              <span class="experience-location">{exp.location}</span>
              <span class="experience-period">{exp.period}</span>
            </div>
          </div>
          <ul class="experience-bullets">
            {exp.bullets.map((bullet) => (
              <li class="experience-bullet">{bullet}</li>
            ))}
          </ul>
          {i < experiences.length - 1 && <div class="experience-rule"></div>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    padding: clamp(5rem, 10vw, 8rem) clamp(1.5rem, 4vw, 3rem);
  }

  .experience-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    margin-bottom: 2.5rem;
  }

  .experience-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .experience-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .experience-role {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .experience-title {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--c-ink);
    margin: 0;
  }

  .experience-company {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    color: var(--c-body);
  }

  .experience-meta {
    display: flex;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--c-muted);
  }

  .experience-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-width: 52rem;
  }

  .experience-bullet {
    position: relative;
    padding-left: 0.875rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--c-body);
  }

  .experience-bullet::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--c-accent);
  }

  .experience-rule {
    width: 100%;
    height: 1px;
    background-color: var(--c-rule);
    margin: 1.25rem 0;
  }

  @media (min-width: 640px) {
    .experience-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }
</style>
