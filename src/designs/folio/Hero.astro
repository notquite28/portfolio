---
import { profile } from '../../data/content';
---

<section class="hero">
  <div class="hero-aura" aria-hidden="true"></div>
  <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
  <div class="hero-orb hero-orb-2" aria-hidden="true"></div>
  <div class="hero-inner">
    <p class="hero-eyebrow">{profile.role}</p>
    <h1 class="hero-name" data-split-name>{profile.name}</h1>
    <div class="hero-rule"></div>
    <p class="hero-tagline">{profile.tagline}</p>
    <div class="hero-links">
      <a href="#work" class="hero-link magnetic">
        <span class="hero-link-text">Selected work</span>
      </a>
      <a href="#contact" class="hero-link magnetic">
        <span class="hero-link-text">Get in touch</span>
      </a>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true">
    <div class="hero-scroll-line"></div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import SplitType from 'split-type';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nameEl = document.querySelector('[data-split-name]') as HTMLElement | null;

  // Run synchronously to hide raw text immediately (outside font gate)
  gsap.set('.hero-eyebrow', { opacity: 0, y: 20 });
  gsap.set('.hero-rule', { scaleX: 0, opacity: 0 });
  gsap.set('.hero-tagline', { opacity: 0, y: 10 });
  gsap.set('.hero-links', { opacity: 0, y: 20 });

  if (nameEl && !prefersReducedMotion) {
    document.fonts.ready.then(async () => {
      await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

      const split = new SplitType(nameEl, { types: 'chars' });
      const chars = split.chars ?? [];

      gsap.set(chars, { y: 60, opacity: 0, rotateX: -40 });

      const tl = gsap.timeline({ delay: 0.3 });

      tl.to(chars, {
        y: 0,
        opacity: 1,
        rotateX: 0,
        duration: 1.1,
        ease: 'power3.out',
        stagger: 0.03,
      })
      .to('.hero-eyebrow', { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' }, '-=0.8')
      .to('.hero-rule', { scaleX: 1, opacity: 1, duration: 0.9, ease: 'power3.inOut' }, '-=0.5')
      .to('.hero-tagline', { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out' }, '-=0.6')
      .to('.hero-links', { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' }, '-=0.5');
    });

    // Ambient floating orbs respond to mouse — stays outside font gate (pointer-driven)
    const hero = document.querySelector('.hero') as HTMLElement | null;
    if (hero) {
      const orb1X = gsap.quickTo('.hero-orb-1', 'x', { duration: 1.5, ease: 'power2.out' });
      const orb1Y = gsap.quickTo('.hero-orb-1', 'y', { duration: 1.5, ease: 'power2.out' });
      const orb2X = gsap.quickTo('.hero-orb-2', 'x', { duration: 1.5, ease: 'power2.out' });
      const orb2Y = gsap.quickTo('.hero-orb-2', 'y', { duration: 1.5, ease: 'power2.out' });

      hero.addEventListener('mousemove', (e) => {
        const rect = hero.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        orb1X(x * 60);
        orb1Y(y * 40);
        orb2X(x * -40);
        orb2Y(y * -30);
      });
    }
  } else if (nameEl) {
    gsap.set('.hero-eyebrow, .hero-name, .hero-rule, .hero-tagline, .hero-links', { opacity: 1, y: 0 });
  }
</script>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    position: relative;
    overflow: hidden;
  }

  .hero-aura {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 42rem 36rem at 50% 52%, rgba(201, 123, 90, 0.12), transparent 72%),
      radial-gradient(ellipse 56rem 42rem at 50% 50%, rgba(240, 235, 228, 0.04), transparent 76%);
    filter: blur(2px);
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(80px);
  }

  .hero-orb-1 {
    width: 28rem;
    height: 28rem;
    background: rgba(201, 123, 90, 0.08);
    top: 15%;
    left: 20%;
  }

  .hero-orb-2 {
    width: 22rem;
    height: 22rem;
    background: rgba(201, 168, 108, 0.05);
    bottom: 20%;
    right: 15%;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.15rem;
    perspective: 800px;
  }

  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .hero-name {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.8rem, 12vw, 10rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--c-ink);
    white-space: nowrap;
    contain: layout style;
  }

  .hero-name :global(.char) {
    display: inline-block;
    transform-origin: center bottom;
  }

  .hero-rule {
    width: clamp(4rem, 10vw, 8rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--c-accent-soft), transparent);
    transform-origin: center;
  }

  .hero-tagline {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    font-weight: 300;
    font-style: italic;
    color: var(--c-body);
    max-width: 36rem;
    line-height: 1.6;
  }

  .hero-links {
    display: flex;
    gap: 0.85rem;
    margin-top: 0.45rem;
  }

  .hero-link {
    position: relative;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--c-ink);
    padding: 0.65rem 0.95rem;
    transition: color 360ms var(--ease-expo);
  }

  .hero-link:hover {
    color: var(--c-accent-soft);
  }

  .hero-link::after {
    content: '';
    position: absolute;
    bottom: 0.45rem;
    left: 0.95rem;
    width: calc(100% - 1.9rem);
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 360ms var(--ease-expo);
  }

  .hero-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .hero-scroll-line {
    width: 1px;
    height: 3rem;
    background: linear-gradient(to bottom, var(--c-muted), transparent);
    animation: scrollPulse 2.2s var(--ease-expo) infinite;
  }

  @keyframes scrollPulse {
    0% { opacity: 1; transform: scaleY(1); }
    50% { opacity: 0.3; transform: scaleY(0.5); }
    100% { opacity: 1; transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-name,
    .hero-rule,
    .hero-tagline,
    .hero-links {
      opacity: 1;
      transform: none;
    }
    .hero-orb {
      display: none;
    }
    .hero-scroll-line {
      animation: none;
    }
  }
</style>
