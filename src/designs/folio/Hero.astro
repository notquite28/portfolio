---
import { profile } from '../../data/content';
import { buildUrl } from '../../utils/paths';

const [firstName = profile.name, ...restName] = profile.name.split(' ');
const lastName = restName.join(' ');
const heroVideoSrc = buildUrl('hero-video-scrub.mp4');
const heroPosterSrc = buildUrl('hero-poster.jpg');
---

<section class="hero" data-hero-scrub>
  <div class="hero-stage">
    <div class="hero-media" data-hero-media>
      <video class="hero-video" data-hero-video data-src={heroVideoSrc} muted playsinline preload="metadata" poster={heroPosterSrc} aria-hidden="true"></video>
      <img class="hero-poster" data-hero-poster src={heroPosterSrc} alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-vignette" aria-hidden="true"></div>
      <div class="hero-tint" aria-hidden="true"></div>
    </div>

    <div class="hero-fade" data-hero-fade aria-hidden="true"></div>
    <div class="hero-preloader" data-hero-preloader aria-hidden="true">
      <div class="hero-preloader-mark">{firstName.slice(0, 1)}{lastName.slice(0, 1)}</div>
      <div class="hero-preloader-line"></div>
    </div>

    <div class="hero-content" aria-label={`${profile.name}: ${profile.tagline}`}>
      <h1 class="hero-name" data-hero-name>
        <span class="hero-name-part" data-hero-first>{firstName}</span>
        {lastName && <span class="hero-name-part" data-hero-last>{lastName}</span>}
      </h1>
      <p class="hero-tagline" data-hero-tagline>{profile.tagline}</p>
      <div class="hero-links" data-hero-cta>
        <a href="#work" class="hero-link hero-link-primary" data-hero-scroll-link>
          <span>Selected work</span>
          <span class="hero-link-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
        <a href="#contact" class="hero-link" data-hero-scroll-link>Get in touch</a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('[data-hero-scrub]');

  if (section) {
    const video = section.querySelector<HTMLVideoElement>('[data-hero-video]');
    const media = section.querySelector<HTMLElement>('[data-hero-media]');
    const fade = section.querySelector<HTMLElement>('[data-hero-fade]');
    const name = section.querySelector<HTMLElement>('[data-hero-name]');
    const first = section.querySelector<HTMLElement>('[data-hero-first]');
    const last = section.querySelector<HTMLElement>('[data-hero-last]');
    const tagline = section.querySelector<HTMLElement>('[data-hero-tagline]');
    const cta = section.querySelector<HTMLElement>('[data-hero-cta]');

    const preloader = section.querySelector<HTMLElement>('[data-hero-preloader]');
    const mobileMedia = window.matchMedia('(max-width: 767px)');
    const motionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');

    let ctx: gsap.Context | null = null;
    let removeCanPlayListener: (() => void) | null = null;
    let removeMediaFailureListeners: (() => void) | null = null;
    let removeTopRestoreListener: (() => void) | null = null;
    let removeActivationListener: (() => void) | null = null;
    let removeFragmentLinkListeners: (() => void) | null = null;
    let activateForNavigation: (() => Promise<boolean>) | null = null;
    let activeFragmentTarget: Element | null = null;
    let cancelVideoSeek: (() => void) | null = null;
    let scrubLoadTimeout: number | null = null;

    const getPreferredScrollBehavior = (): ScrollBehavior => (motionMedia.matches ? 'auto' : 'smooth');
    const ensureVideoSource = () => {
      if (!video || video.currentSrc || video.src) return;
      const source = video.dataset.src;
      if (!source) return;
      video.preload = 'auto';
      video.src = source;
      video.load();
    };

    const revealHero = () => {
      if (scrubLoadTimeout !== null) {
        window.clearTimeout(scrubLoadTimeout);
        scrubLoadTimeout = null;
      }
      section.classList.add('is-ready');
      section.classList.remove('is-preloading');
    };

    const fragmentLinkCleanups = Array.from(
      section.querySelectorAll<HTMLAnchorElement>('[data-hero-scroll-link]'),
      (link) => {
        const navigateToFragment = async (event: MouseEvent) => {
          const id = link.hash;
          const target = id ? document.querySelector(id) : null;
          if (!target) return;
          event.preventDefault();
          activeFragmentTarget = target;
          const useInstantScroll = (await activateForNavigation?.()) ?? false;
          target.scrollIntoView({ behavior: useInstantScroll ? 'auto' : getPreferredScrollBehavior() });
          if (!useInstantScroll) activeFragmentTarget = null;
        };

        link.addEventListener('click', navigateToFragment);
        return () => link.removeEventListener('click', navigateToFragment);
      },
    );
    removeFragmentLinkListeners = () => fragmentLinkCleanups.forEach((removeListener) => removeListener());

    const cleanupScrub = () => {
      cancelVideoSeek?.();
      cancelVideoSeek = null;
      removeCanPlayListener?.();
      removeCanPlayListener = null;
      removeMediaFailureListeners?.();
      removeMediaFailureListeners = null;
      removeTopRestoreListener?.();
      removeTopRestoreListener = null;
      removeActivationListener?.();
      removeActivationListener = null;
      activateForNavigation = null;
      activeFragmentTarget = null;
      if (scrubLoadTimeout !== null) {
        window.clearTimeout(scrubLoadTimeout);
        scrubLoadTimeout = null;
      }
      ctx?.revert();
      ctx = null;
    };

    const init = () => {
      cleanupScrub();

      ctx = gsap.context(() => {
        const useStaticHero = mobileMedia.matches || motionMedia.matches || !video;
        let scrubState: 'idle' | 'loading' | 'ready' | 'failed' = 'idle';
        let useInstantFragmentScroll = false;


        if (useStaticHero) {
          section.classList.remove('is-scrub', 'is-preloading');
          section.classList.add('is-static');
          gsap.set(section, { height: '100svh' });
          gsap.set(media, { autoAlpha: 1 });
          gsap.set(fade, { autoAlpha: 0 });
          gsap.set(preloader, { autoAlpha: 0 });
          gsap.set([name, tagline, cta], { autoAlpha: 1, y: 0 });
          gsap.set([first, last], { xPercent: 0, autoAlpha: 1 });

          activateForNavigation = () => Promise.resolve(false);
          revealHero();
          return;
        }

        section.classList.remove('is-static', 'is-ready');
        gsap.set(section, { height: '100svh' });

        const syncHeroHeight = () => {
          const duration = video.duration || 6;
          const scrollVh = Math.min(Math.max(duration * 55 + 90, 340), 520);
          gsap.set(section, { height: `${scrollVh}vh` });
        };

        const restoreIntroState = () => {
          gsap.set(media, { autoAlpha: 1 });
          gsap.set(fade, { autoAlpha: 0 });
          gsap.set([name, tagline, cta], { autoAlpha: 1, y: 0 });
          gsap.set([first, last], { xPercent: 0, autoAlpha: 1 });

        };

        const createScrollTimeline = () => {
          if (!video.duration || Number.isNaN(video.duration)) return;
          if (scrubState !== 'loading' || !section.classList.contains('is-scrub')) return;
          scrubState = 'ready';
          if (scrubLoadTimeout !== null) {
            window.clearTimeout(scrubLoadTimeout);
            scrubLoadTimeout = null;
          }
          removeCanPlayListener?.();
          removeCanPlayListener = null;
          removeMediaFailureListeners?.();
          removeMediaFailureListeners = null;

          syncHeroHeight();
          video.pause();
          video.currentTime = 0;
          restoreIntroState();
          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => {
              gsap.to(preloader, { autoAlpha: 0, duration: 0.38, ease: 'power2.out', onComplete: revealHero });
            });
          });

          const duration = video.duration;
          const lastFrameTime = Math.max(duration - 0.001, 0);
          const minSeekDelta = Math.max(1 / 48, duration / 900);
          let targetTime = 0;
          let seekRaf = 0;

          const flushSeek = () => {
            seekRaf = 0;
            const nextTime = Math.min(Math.max(targetTime, 0), lastFrameTime);
            if (Math.abs(video.currentTime - nextTime) >= minSeekDelta) {
              video.currentTime = nextTime;
            }
          };

          const scheduleSeek = () => {
            if (!seekRaf) seekRaf = window.requestAnimationFrame(flushSeek);
          };

          cancelVideoSeek = () => {
            if (seekRaf) window.cancelAnimationFrame(seekRaf);
            seekRaf = 0;
          };

          const forceTopState = () => {
            if (window.scrollY > 1) return;
            targetTime = 0;
            cancelVideoSeek?.();
            if (video.currentTime !== 0) video.currentTime = 0;
            restoreIntroState();
          };

          window.addEventListener('scroll', forceTopState, { passive: true });
          const topStateTicker = () => forceTopState();
          gsap.ticker.add(topStateTicker);
          removeTopRestoreListener = () => {
            window.removeEventListener('scroll', forceTopState);
            gsap.ticker.remove(topStateTicker);
          };

          const visualTl = gsap.timeline({ paused: true, defaults: { ease: 'none' } });
          visualTl

            .to(tagline, { autoAlpha: 0, y: -15, duration: 0.18, ease: 'power2.in' }, 0.14)
            .to(cta, { autoAlpha: 0, duration: 0.16, ease: 'power2.in' }, 0.16)
            .to(first, { xPercent: -88, autoAlpha: 0, duration: 0.28, ease: 'power2.inOut' }, 0.34)
            .to(last, { xPercent: 88, autoAlpha: 0, duration: 0.28, ease: 'power2.inOut' }, 0.34)
            .to(fade, { autoAlpha: 1, duration: 0.18, ease: 'power2.inOut' }, 0.72)
            .to(media, { autoAlpha: 0, duration: 0.05, ease: 'power2.out' }, 0.95);

          ScrollTrigger.create({
            trigger: section,
            start: 'top top',
            end: 'bottom top',
            invalidateOnRefresh: true,
            onRefresh: syncHeroHeight,
            onUpdate: (self) => {
              const progress = self.progress;

              if (progress <= 0.002) {
                targetTime = 0;
                cancelVideoSeek?.();
                if (video.currentTime !== 0) video.currentTime = 0;
                restoreIntroState();
                return;
              }

              targetTime = progress * duration;
              visualTl.progress(progress);
              scheduleSeek();
            },
          });

          ScrollTrigger.refresh();
        };

        const refreshScrubGeometry = () => {
          ScrollTrigger.refresh();
          return Promise.resolve(useInstantFragmentScroll);
        };

        const fallBackToStatic = () => {
          if (scrubState === 'failed') return;
          const navigationTarget = activeFragmentTarget?.isConnected ? activeFragmentTarget : null;
          const navigationViewportTop = navigationTarget?.getBoundingClientRect().top ?? null;
          scrubState = 'failed';
          removeCanPlayListener?.();
          removeCanPlayListener = null;
          removeMediaFailureListeners?.();
          removeMediaFailureListeners = null;
          removeActivationListener?.();
          removeActivationListener = null;
          section.classList.remove('is-scrub', 'is-preloading');
          section.classList.add('is-static');
          gsap.set(section, { height: '100svh' });
          restoreIntroState();
          revealHero();
          ScrollTrigger.refresh();
          if (navigationTarget && navigationViewportTop !== null) {
            const shiftedTargetTop = navigationTarget.getBoundingClientRect().top;
            window.scrollTo({
              top: window.scrollY + shiftedTargetTop - navigationViewportTop,
              behavior: 'auto',
            });
          }
        };

        const activateScrub = () => {
          if (scrubState === 'failed') return Promise.resolve(useInstantFragmentScroll);

          if (scrubState === 'idle') {
            scrubState = 'loading';
            section.classList.remove('is-static');
            section.classList.add('is-scrub', 'is-preloading');
            gsap.set(section, { clearProps: 'height' });
            useInstantFragmentScroll = true;
            document.dispatchEvent(new Event('hero-scrub-activated'));

            const handleMediaFailure = () => fallBackToStatic();
            video.addEventListener('error', handleMediaFailure, { once: true });
            removeMediaFailureListeners = () => {
              video.removeEventListener('error', handleMediaFailure);
            };

            scrubLoadTimeout = window.setTimeout(fallBackToStatic, 4000);
            if (video.readyState >= HTMLMediaElement.HAVE_ENOUGH_DATA) {
              createScrollTimeline();
            } else {
              video.addEventListener('canplaythrough', createScrollTimeline, { once: true });
              removeCanPlayListener = () => video.removeEventListener('canplaythrough', createScrollTimeline);
            }

            ensureVideoSource();
          }

          return refreshScrubGeometry();
        };

        activateForNavigation = activateScrub;

        const activateOnScroll = () => {
          if (window.scrollY <= 1) return;
          removeActivationListener?.();
          removeActivationListener = null;
          void activateScrub();
        };

        window.addEventListener('scroll', activateOnScroll, { passive: true });
        removeActivationListener = () => window.removeEventListener('scroll', activateOnScroll);
        restoreIntroState();
        activateOnScroll();
      }, section);
    };

    init();
    mobileMedia.addEventListener('change', init);
    motionMedia.addEventListener('change', init);

    window.addEventListener('beforeunload', () => {
      mobileMedia.removeEventListener('change', init);
      motionMedia.removeEventListener('change', init);
      cleanupScrub();
      removeFragmentLinkListeners?.();
      removeFragmentLinkListeners = null;
    });
  }
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 100svh;
    background: var(--c-surface);
  }

  /* Animated intro: JS opts in by adding .is-scrub (desktop + motion-OK). */
  .hero.is-scrub {
    height: 376.5vh;
  }

  .hero-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .hero-media,
  .hero-fade,
  .hero-preloader,
  .hero-content {
    position: absolute;
  }

  .hero-media,
  .hero-fade {
    inset: 0;
  }

  .hero-media {
    z-index: 0;
    background: var(--c-surface);
  }

  .hero-video,
  .hero-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-video {
    display: none;
  }

  .hero.is-scrub .hero-video {
    display: block;
  }

  .hero.is-scrub .hero-poster {
    display: none;
  }

  .hero-noise,
  .hero-vignette,
  .hero-tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-noise {
    opacity: 0.1;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 128px 128px;
  }

  .hero-vignette {
    background: radial-gradient(ellipse at center, rgba(6, 16, 19, 0.05) 20%, rgba(5, 12, 15, 0.48) 100%);
  }

  .hero-tint {
    background: radial-gradient(circle at 50% 48%, rgba(3, 13, 14, 0.18), rgba(3, 13, 14, 0.24) 46%, rgba(3, 13, 14, 0.08) 72%);
  }

  .hero-fade {
    z-index: 3;
    opacity: 0;
    pointer-events: none;
    background: var(--c-surface);
  }

  .hero-preloader {
    z-index: 5;
    inset: 0;
    display: none;
    place-items: center;
    gap: 1.25rem;
    align-content: center;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 48%, color-mix(in oklch, var(--c-water-mint) 10%, transparent), transparent 22rem),
      linear-gradient(180deg, color-mix(in oklch, var(--c-pond-850) 92%, transparent), var(--c-surface));
    opacity: 1;
  }

  .hero.is-preloading .hero-preloader {
    display: grid;
  }

  .hero-preloader-mark {
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border: 1px solid color-mix(in oklch, var(--c-water-mint) 26%, transparent);
    border-radius: 999px;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    box-shadow: inset 0 1px 0 rgba(255, 247, 231, 0.08), 0 0 3rem color-mix(in oklch, var(--c-koi-orange) 12%, transparent);
  }

  .hero-preloader-line {
    width: 8rem;
    height: 1px;
    overflow: hidden;
    background: rgba(255, 247, 231, 0.12);
  }

  .hero-preloader-line::after {
    content: '';
    display: block;
    width: 45%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--c-accent-soft), transparent);
    animation: heroPreload 1.1s var(--ease-expo) infinite;
  }

  .hero.is-preloading .hero-content {
    opacity: 0;
  }

  @keyframes heroPreload {
    from { transform: translateX(-110%); }
    to { transform: translateX(235%); }
  }

  .hero-content {
    z-index: 2;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 clamp(1.5rem, 5vw, 4rem);
    text-align: center;
  }


  .hero-name {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.28em;
    margin: 0;
    overflow: visible;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 5.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .hero-name-part {
    display: inline-block;
    will-change: transform, opacity;
  }

  .hero-name-part:first-child {
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.72), 0 0 90px color-mix(in oklch, var(--c-water-mint) 22%, transparent);
  }

  .hero-name-part:last-child {
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.72), 0 0 90px color-mix(in oklch, var(--c-koi-orange) 18%, transparent);
  }

  .hero-tagline {
    max-width: 32.5rem;
    margin: 2rem 0 0;
    color: rgba(255, 247, 231, 0.9);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.8vw, 1.0625rem);
    line-height: 1.7;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.7);
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-top: 2rem;
  }

  .hero-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0;
    color: rgba(255, 247, 231, 0.82);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
    transition: color 220ms var(--ease-expo);
  }

  .hero-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 360ms var(--ease-expo);
    opacity: 0.72;
  }

  .hero-link:hover {
    color: var(--c-ink);
  }

  .hero-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .hero-link-primary {
    color: var(--c-ink);
    font-weight: 600;
  }

  .hero-link-primary::after {
    background: color-mix(in oklch, var(--c-koi-gold) 70%, var(--c-ink));
    opacity: 1;
    transform: scaleX(1);
    transform-origin: left;
  }

  .hero-link-primary:hover {
    color: var(--c-cream);
  }

  .hero-link-primary:hover .hero-link-icon {
    transform: translateX(4px);
  }

  .hero-link-icon {
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    transition: transform 220ms var(--ease-expo);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-link,
    .hero-link-icon,
    .hero-link::after {
      transition: none;
    }

    .hero-link-primary:hover .hero-link-icon {
      transform: none;
    }
  }

  @media (max-width: 520px) {
    .hero-name {
      font-size: clamp(3rem, 16vw, 5rem);
      gap: 0.1em 0.28em;
    }

    .hero-links {
      gap: 1.1rem;
      flex-wrap: wrap;
      justify-content: center;
    }
  }

</style>
