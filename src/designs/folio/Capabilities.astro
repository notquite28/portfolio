---
import { skillCategories } from '../../data/content';
---

<section id="skills" class="capabilities reveal">
  <div class="capabilities-inner">
    <p class="kicker">Capabilities</p>
    <h2 class="section-title">Tools I use most.</h2>
    <div class="skill-groups">
      {skillCategories.map((category) => (
        <div class="skill-group">
          <div class="skill-group-left">
            <h3 class="skill-group-title">{category.title}</h3>
          </div>
          <div class="skill-group-right">
            <ul class="skill-list">
              {category.skills.map((skill) => (
                <li class="skill-item">{skill}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .capabilities {
    padding: clamp(5rem, 10vw, 8rem) clamp(1.5rem, 4vw, 3rem);
  }

  .capabilities-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    margin-bottom: 2.5rem;
  }

  .skill-groups {
    display: grid;
    gap: 0;
  }

  .skill-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-rule);
  }

  .skill-group + .skill-group {
    margin-top: 1.5rem;
  }

  .skill-group-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-ink);
    letter-spacing: 0.01em;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }

  .skill-item {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--c-body);
    line-height: 1.8;
  }

  .skill-item:not(:last-child)::after {
    content: ' / ';
    color: var(--c-rule);
    margin: 0 0.4em;
  }

  @media (min-width: 640px) {
    .skill-group {
      grid-template-columns: 14rem 1fr;
      gap: 1rem;
      align-items: start;
    }
  }
</style>
