---
import { skillCategories } from '../../data/content';
---

<section id="skills" class="capabilities">
  <div class="capabilities-inner">
    <p class="kicker reveal">Capabilities</p>
    <h2 class="section-title reveal">Tools I work with.</h2>
    <div class="skill-groups reveal-group">
      {skillCategories.map((category) => (
        <div class="skill-group reveal-child">
          <div class="skill-group-left">
            <h3 class="skill-group-title">{category.title}</h3>
            <div class="skill-group-bar" aria-hidden="true">
              <div class="skill-group-bar-fill"></div>
            </div>
          </div>
          <div class="skill-group-right">
            <ul class="skill-list">
              {category.skills.map((skill) => (
                <li class="skill-item">{skill}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    ScrollTrigger.matchMedia({
      "(min-width: 768px)": function () {
        const triggers: ScrollTrigger[] = [];

        const groups = document.querySelectorAll('.skill-group');
        groups.forEach((group) => {
          const barFill = group.querySelector('.skill-group-bar-fill') as HTMLElement | null;
          const items = group.querySelectorAll('.skill-item');

          if (barFill) {
            triggers.push(ScrollTrigger.create({
              trigger: group,
              start: 'top 82%',
              once: true,
              animation: gsap.fromTo(barFill, { scaleX: 0 }, { scaleX: 1, duration: 1, ease: 'power3.out' }),
            }));
          }

          triggers.push(ScrollTrigger.create({
            trigger: group,
            start: 'top 78%',
            once: true,
            animation: gsap.fromTo(items, { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: 'power3.out', stagger: 0.05 }),
          }));
        });

        return function () { triggers.forEach((t) => t.kill()); };
      },
    });
  }
</script>

<style>
  .capabilities {
    padding: clamp(6rem, 12vw, 10rem) clamp(1.5rem, 4vw, 3rem);
    position: relative;
  }

  .capabilities-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-accent-soft);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--c-ink);
    margin-bottom: 3rem;
  }

  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .skill-group {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid var(--c-rule);
    transition: border-color 400ms var(--ease-expo);
  }

  .skill-group:last-child {
    border-bottom: 1px solid var(--c-rule);
  }

  .skill-group:hover {
    border-color: color-mix(in oklch, var(--c-water-mint) 34%, var(--c-rule));
  }

  .skill-group-left {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skill-group-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-ink);
    letter-spacing: 0.01em;
    transition: color 300ms var(--ease-expo);
  }

  .skill-group:hover .skill-group-title {
    color: var(--c-gold);
  }

  .skill-group-bar {
    width: 3rem;
    height: 2px;
    background: var(--c-rule);
    border-radius: 1px;
    overflow: hidden;
  }

  .skill-group-bar-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--c-water-mint), var(--c-koi-gold));
    transform-origin: left;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-item {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--c-body);
    line-height: 1.6;
    padding: 0.35rem 0.85rem;
    border: 1px solid color-mix(in oklch, var(--c-water-mint) 18%, var(--c-rule));
    border-radius: 100px;
    background: color-mix(in oklch, var(--c-water-mint) 6%, var(--c-elevated));
    transition:
      color 300ms var(--ease-expo),
      border-color 300ms var(--ease-expo),
      background 300ms var(--ease-expo),
      transform 300ms var(--ease-expo);
  }

  .skill-item:hover {
    color: var(--c-ink);
    border-color: color-mix(in oklch, var(--c-koi-gold) 38%, var(--c-rule));
    background: color-mix(in oklch, var(--c-koi-gold) 7%, var(--c-elevated));
    transform: translateY(-1px);
  }

  @media (min-width: 640px) {
    .skill-group {
      grid-template-columns: 14rem 1fr;
      gap: 2rem;
      align-items: start;
    }
  }
</style>