---
import { profile } from '../../data/content';
---

<section id="contact" class="contact">
  <div class="contact-inner reveal">
    <h2 class="contact-title">Let's build something together.</h2>
    <p class="contact-desc">Currently seeking software engineering roles focused on backend systems and applied AI.</p>
    <div class="contact-links">
      <a href={`mailto:${profile.email}`} class="contact-link contact-link-primary magnetic" data-magnetic>
        <span class="contact-link-text">Email</span>
      </a>
      <button type="button" class="contact-link contact-link-button magnetic" data-copy-email={profile.email} data-magnetic>
        <span class="contact-link-label" aria-live="polite">Copy email</span>
      </button>
      <a href={profile.github} class="contact-link magnetic" target="_blank" rel="noopener noreferrer" data-magnetic>
        <span class="contact-link-text">GitHub</span>
      </a>
      <a href={profile.linkedin} class="contact-link magnetic" target="_blank" rel="noopener noreferrer" data-magnetic>
        <span class="contact-link-text">LinkedIn</span>
      </a>
      <a href={profile.resume} class="contact-link magnetic" target="_blank" rel="noopener noreferrer" data-magnetic>
        <span class="contact-link-text">Resume</span>
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Copy email
  const copyButtons = document.querySelectorAll('.folio-theme [data-copy-email]');
  copyButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;

    const label = button.querySelector('.contact-link-label');
    const email = button.dataset.copyEmail;
    if (!(label instanceof HTMLSpanElement) || !email) return;

    const defaultLabel = label.textContent ?? 'Copy email';
    let resetTimer: number | undefined;

    button.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
        await navigator.clipboard.writeText(email);
        label.textContent = 'Copied';
        button.dataset.copied = 'true';
      } catch {
        window.location.href = `mailto:${email}`;
        label.textContent = 'Opening email';
      }

      if (resetTimer) window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        label.textContent = defaultLabel;
        delete button.dataset.copied;
      }, 1600);
    });
  });

  // Magnetic effect — keep transforms only via GSAP x/y so underlines stay aligned.
  const magneticControllers: AbortController[] = [];
  if (!prefersReducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const magneticElements = document.querySelectorAll('[data-magnetic]');
    magneticElements.forEach((el) => {
      const controller = new AbortController();
      magneticControllers.push(controller);
      const strength = 0.3;
      const quickX = gsap.quickTo(el, 'x', { duration: 0.6, ease: 'power3.out' });
      const quickY = gsap.quickTo(el, 'y', { duration: 0.6, ease: 'power3.out' });

      // Cache the rect: under Lenis the element moves every frame during inertial
      // scroll, so reading getBoundingClientRect() per mousemove forces sync layout.
      let rect = el.getBoundingClientRect();

      el.addEventListener('mouseenter', () => { rect = el.getBoundingClientRect(); }, { signal: controller.signal });
      el.addEventListener('mousemove', (e: Event) => {
        const me = e as MouseEvent;
        const x = me.clientX - rect.left - rect.width / 2;
        const y = me.clientY - rect.top - rect.height / 2;

        quickX(x * strength);
        quickY(y * strength);
      }, { signal: controller.signal });

      el.addEventListener('mouseleave', () => {
        // Reset through the same quickTo proxies so re-hover keeps working.
        quickX(0);
        quickY(0);
      }, { signal: controller.signal });
    });
  }
</script>

<style>
  .contact {
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem) clamp(6rem, 12vw, 10rem);
    text-align: center;
  }

  .contact-inner {
    max-width: 56rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    border: 1px solid color-mix(in oklch, var(--c-water-mint) 28%, var(--c-card-border));
    border-radius: 1.5rem;
    background:
      radial-gradient(ellipse at 50% 0%, color-mix(in oklch, var(--c-koi-orange) 7%, transparent), transparent 58%),
      linear-gradient(180deg, var(--c-paper), color-mix(in oklch, var(--c-pond-800) 86%, var(--c-surface)));
    box-shadow: var(--shadow-soft), 0 0 0 1px color-mix(in oklch, var(--c-koi-gold) 10%, transparent);
  }

  .contact-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.1rem, 4.2vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--c-ink);
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  .contact-desc {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--c-body);
    max-width: 36rem;
    margin-bottom: 2.5rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.5rem 2.5rem;
  }

  .contact-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--c-ink);
    padding: 0.4rem 0;
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 300ms var(--ease-expo);
  }

  .contact-link::after {
    content: '';
    position: absolute;
    bottom: 0.35rem;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 400ms var(--ease-expo);
    opacity: 0.78;
  }

  .contact-link:hover {
    color: var(--c-accent-soft);
  }

  .contact-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .contact-link-primary {
    font-weight: 600;
    color: var(--c-ink);
  }

  .contact-link-primary::after {
    background: color-mix(in oklch, var(--c-koi-gold) 70%, var(--c-ink));
    opacity: 1;
    transform: scaleX(1);
    transform-origin: left;
  }

  .contact-link-primary:hover {
    color: var(--c-cream);
  }

  .contact-link:active {
    color: var(--c-cream);
  }

  .contact-link-button[data-copied='true'] .contact-link-label {
    color: var(--c-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link::after {
      transition: none;
    }
  }
</style>
