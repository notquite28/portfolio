---
import { profile } from '../../data/content';
---

<section id="contact" class="contact reveal">
  <div class="contact-inner">
    <p class="kicker">Get in touch</p>
    <h2 class="contact-title">Contact</h2>
    <p class="contact-desc">Open to roles in software engineering and applied AI.</p>
    <div class="contact-links">
      <button type="button" class="contact-link contact-link-button" data-copy-email={profile.email}>
        <span class="contact-link-label" aria-live="polite">Copy email</span>
      </button>
      <a href={profile.github} class="contact-link" target="_blank" rel="noopener noreferrer">
        <span class="contact-link-text">GitHub</span>
      </a>
      <a href={profile.linkedin} class="contact-link" target="_blank" rel="noopener noreferrer">
        <span class="contact-link-text">LinkedIn</span>
      </a>
      <a href={profile.resume} class="contact-link" target="_blank" rel="noopener noreferrer">
        <span class="contact-link-text">Resume</span>
      </a>
    </div>
  </div>
</section>

<script>
  const copyButtons = document.querySelectorAll('.folio-theme [data-copy-email]');

  copyButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;

    const label = button.querySelector('.contact-link-label');
    const email = button.dataset.copyEmail;
    if (!(label instanceof HTMLSpanElement) || !email) return;

    const defaultLabel = label.textContent ?? 'Copy email';
    let resetTimer: number | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'Copied';
        button.dataset.copied = 'true';
      } catch {
        window.location.href = `mailto:${email}`;
        label.textContent = 'Opening email';
      }

      if (resetTimer) window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        label.textContent = defaultLabel;
        delete button.dataset.copied;
      }, 1600);
    });
  });
</script>

<style>
  .contact {
    padding: clamp(5rem, 10vw, 8rem) clamp(1.5rem, 4vw, 3rem);
    text-align: center;
  }

  .contact-inner {
    max-width: 44rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: 0.75rem;
  }

  .contact-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    margin-bottom: 1rem;
  }

  .contact-desc {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--c-body);
    max-width: 28rem;
    margin-bottom: 2.5rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 2.25rem;
  }

  .contact-link {
    position: relative;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--c-ink);
    padding-bottom: 2px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .contact-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--c-ink);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 360ms var(--ease-expo);
  }

  .contact-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .contact-link-button[data-copied='true'] .contact-link-label {
    color: var(--c-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link::after {
      transition: none;
    }
  }
</style>
