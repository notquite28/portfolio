---
import { profile } from '../../data/content';
import { buildUrl } from '../../utils/paths';
---

<section id="about" class="about reveal">
  <div class="about-inner">
    <div class="about-image-col">
      <img
        src={buildUrl(profile.image)}
        alt="Portrait of Arnav Panigrahi"
        class="about-portrait"
        loading="lazy"
      />
    </div>
    <div class="about-text-col">
      <p class="kicker">Background</p>
      <h2 class="about-title">About</h2>
      <div class="about-body">
        {profile.about.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="about-facts">
        <div class="about-fact">
          <span class="fact-label">Based in</span>
          <span class="fact-desc">California, United States</span>
        </div>
        <div class="about-fact">
          <span class="fact-label">Education</span>
          <span class="fact-desc">M.S. Computer Science, UC Riverside</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: clamp(5rem, 10vw, 8rem) clamp(1.5rem, 4vw, 3rem);
  }

  .about-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
  }

  .about-portrait {
    display: block;
    width: 100%;
    max-width: 18rem;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid color-mix(in oklch, var(--c-accent) 26%, var(--c-card-border));
    margin: 0 auto;
    box-shadow:
      0 0 0 0.75rem rgba(238, 231, 220, 0.018),
      0 1.5rem 4rem rgba(0, 0, 0, 0.3);
    filter: saturate(0.88) contrast(1.04);
    transition:
      filter 520ms var(--ease-expo),
      transform 520ms var(--ease-expo),
      border-color 520ms var(--ease-expo);
  }

  .about-portrait:hover {
    border-color: color-mix(in oklch, var(--c-accent-soft) 46%, var(--c-card-border));
    filter: saturate(1) contrast(1.06);
    transform: translateY(-3px);
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 0.75rem;
  }

  .about-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    margin-bottom: 1.5rem;
  }

  .about-body {
    max-width: 44rem;
  }

  .about-body p {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.72;
    color: var(--c-body);
    margin-bottom: 1rem;
  }

  .about-body p:last-child {
    margin-bottom: 0;
  }

  .about-facts {
    position: relative;
    overflow: hidden;
    margin-top: 2rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in oklch, var(--c-card-border) 82%, transparent);
    border-radius: 1.25rem;
    background-color: var(--c-paper);
    box-shadow: 0 1rem 2.75rem rgba(0, 0, 0, 0.14);
    display: grid;
    gap: 0;
  }

  .about-fact {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.25rem 0;
  }

  .fact-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-ink);
  }

  .fact-desc {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--c-body);
  }

  @media (min-width: 1024px) {
    .about-inner {
      grid-template-columns: 2fr 3fr;
    }
  }

  @media (min-width: 640px) {
    .about-facts {
      grid-template-columns: 1fr 1fr;
    }

    .about-fact + .about-fact {
      border-left: 1px solid var(--c-rule);
      padding-left: clamp(1.5rem, 4vw, 2.25rem);
    }
  }

  @media (max-width: 639px) {
    .about-fact + .about-fact {
      border-top: 1px solid var(--c-rule);
      padding-top: 1rem;
      margin-top: 1rem;
    }
  }
</style>
