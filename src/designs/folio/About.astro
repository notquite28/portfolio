---
import { profile } from '../../data/content';
import { buildUrl } from '../../utils/paths';
---

<section id="about" class="about">
  <div class="about-inner">
    <div class="about-image-col">
      <div class="about-image-shell" data-parallax="0.12">
        <div class="about-image-frame">
          <img
            src={buildUrl(profile.image)}
            alt="Portrait of Arnav Panigrahi"
            class="about-portrait"
            width="1147"
            height="1147"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
    <div class="about-text-col">
      <h2 class="about-title reveal">About</h2>
      <div class="about-body reveal-group">
        {profile.about.map((paragraph) => (
          <p class="reveal-child">{paragraph}</p>
        ))}
      </div>
      <div class="about-facts reveal-group">
        <div class="about-fact reveal-child">
          <span class="fact-label">Based in</span>
          <span class="fact-desc">California, United States</span>
        </div>
        <div class="about-fact reveal-child">
          <span class="fact-label">Education</span>
          <span class="fact-desc">M.S. Computer Science, UC Riverside</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: clamp(5rem, 10vw, 8rem) clamp(1.5rem, 4vw, 3rem);
    position: relative;
  }

  .about-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
  }

  .about-image-col {
    display: flex;
    justify-content: center;
  }

  .about-image-shell {
    position: relative;
    width: 100%;
    max-width: 16rem;
    padding: 0.4rem;
    border-radius: 1.75rem;
    border: 1px solid color-mix(in oklch, var(--c-water-mint) 22%, transparent);
    background: color-mix(in oklch, var(--c-pond-800) 70%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklch, var(--c-cream) 8%, transparent),
      0 1rem 2.5rem color-mix(in oklch, var(--c-pond-900) 45%, transparent);
    will-change: transform;
  }

  .about-image-frame {
    position: relative;
    overflow: hidden;
    border-radius: calc(1.75rem - 0.35rem);
    background: var(--c-elevated);
    box-shadow: inset 0 1px 1px color-mix(in oklch, var(--c-cream) 10%, transparent);
  }

  .about-portrait {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }


  .about-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.1rem, 4.2vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--c-ink);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .about-body {
    max-width: 44rem;
  }

  .about-body p {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--c-body);
    margin-bottom: 0.85rem;
  }

  .about-body p:last-child {
    margin-bottom: 0;
  }

  .about-facts {
    margin-top: 1.75rem;
    padding: clamp(1rem, 2vw, 1.5rem) 0;
    border-top: 1px solid color-mix(in oklch, var(--c-water-mint) 26%, transparent);
    border-bottom: 1px solid color-mix(in oklch, var(--c-koi-gold) 20%, transparent);
    display: grid;
    gap: 1.5rem;
  }

  .about-fact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .fact-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c-gold);
  }

  .fact-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--c-body);
  }

  @media (min-width: 1024px) {
    .about-inner {
      grid-template-columns: 2fr 3fr;
    }
  }

  @media (min-width: 640px) {
    .about-facts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
