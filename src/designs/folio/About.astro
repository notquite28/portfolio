---
import { profile } from '../../data/content';
import { buildUrl } from '../../utils/paths';
---

<section id="about" class="about">
  <div class="about-inner">
    <div class="about-image-col">
      <div class="about-image-frame" data-parallax="0.12">
        <img
          src={buildUrl(profile.image)}
          alt="Portrait of Arnav Panigrahi"
          class="about-portrait"
          loading="lazy"
        />
        <div class="about-image-border" aria-hidden="true"></div>
      </div>
    </div>
    <div class="about-text-col">
      <p class="kicker reveal">Background</p>
      <h2 class="about-title reveal">About</h2>
      <div class="about-body reveal-group">
        {profile.about.map((paragraph) => (
          <p class="reveal-child">{paragraph}</p>
        ))}
      </div>
      <div class="about-facts reveal-group">
        <div class="about-fact reveal-child">
          <span class="fact-label">Based in</span>
          <span class="fact-desc">California, United States</span>
        </div>
        <div class="about-fact reveal-child">
          <span class="fact-label">Education</span>
          <span class="fact-desc">M.S. Computer Science, UC Riverside</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: clamp(6rem, 12vw, 10rem) clamp(1.5rem, 4vw, 3rem);
    position: relative;
  }

  .about-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .about-image-col {
    display: flex;
    justify-content: center;
  }

  .about-image-frame {
    position: relative;
    width: 100%;
    max-width: 20rem;
    will-change: transform;
  }

  .about-portrait {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    filter: saturate(0.85) contrast(1.04);
    transition: filter 600ms var(--ease-expo), transform 600ms var(--ease-expo);
  }

  .about-image-frame:hover .about-portrait {
    filter: saturate(1) contrast(1.06);
    transform: scale(1.02);
  }

  .about-image-border {
    position: absolute;
    inset: -0.5rem;
    border-radius: 50%;
    border: 1px solid color-mix(in oklch, var(--c-accent) 20%, var(--c-card-border));
    transition: border-color 600ms var(--ease-expo), transform 600ms var(--ease-expo);
    pointer-events: none;
  }

  .about-image-frame:hover .about-image-border {
    border-color: color-mix(in oklch, var(--c-accent-soft) 35%, var(--c-card-border));
    transform: scale(1.03);
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 0.75rem;
  }

  .about-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--c-ink);
    margin-bottom: 1.75rem;
  }

  .about-body {
    max-width: 44rem;
  }

  .about-body p {
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--c-body);
    margin-bottom: 1.1rem;
  }

  .about-body p:last-child {
    margin-bottom: 0;
  }

  .about-facts {
    position: relative;
    overflow: hidden;
    margin-top: 2.5rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid color-mix(in oklch, var(--c-card-border) 70%, transparent);
    border-radius: 1rem;
    background:
      linear-gradient(135deg, rgba(201, 123, 90, 0.03), transparent 60%),
      var(--c-paper);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.16);
    display: grid;
    gap: 0;
  }

  .about-fact {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.25rem 0;
  }

  .fact-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink);
  }

  .fact-desc {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--c-body);
  }

  @media (min-width: 1024px) {
    .about-inner {
      grid-template-columns: 2fr 3fr;
    }
  }

  @media (min-width: 640px) {
    .about-facts {
      grid-template-columns: 1fr 1fr;
    }

    .about-fact + .about-fact {
      border-left: 1px solid var(--c-rule);
      padding-left: clamp(1.5rem, 4vw, 2.25rem);
    }
  }

  @media (max-width: 639px) {
    .about-fact + .about-fact {
      border-top: 1px solid var(--c-rule);
      padding-top: 1rem;
      margin-top: 1rem;
    }
  }
</style>
