---
import { profile } from '../../data/content';
import { buildUrl } from '../../utils/paths';
---

<section id="about" class="about reveal">
  <div class="about-inner">
    <div class="about-image-col">
      <img
        src={buildUrl(profile.image)}
        alt="Portrait of Arnav Panigrahi"
        class="about-portrait"
        loading="lazy"
      />
    </div>
    <div class="about-text-col">
      <p class="kicker">About</p>
      <h2 class="about-title">About</h2>
      <div class="about-body">
        {profile.about.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="about-facts">
        <div class="about-fact">
          <span class="fact-label">Based in</span>
          <span class="fact-desc">California, United States</span>
        </div>
        <div class="about-fact">
          <span class="fact-label">Education</span>
          <span class="fact-desc">M.S. Computer Science, UC Riverside</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: clamp(5rem, 10vw, 8rem) clamp(1.5rem, 4vw, 3rem);
  }

  .about-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  .about-portrait {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1rem;
    border: 1px solid var(--c-card-border);
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: 0.75rem;
  }

  .about-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    margin-bottom: 1.5rem;
  }

  .about-body {
    max-width: 44rem;
  }

  .about-body p {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.72;
    color: var(--c-body);
    margin-bottom: 1rem;
  }

  .about-body p:last-child {
    margin-bottom: 0;
  }

  .about-facts {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-rule);
    display: grid;
    gap: 1.5rem;
  }

  .about-fact {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .fact-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-ink);
  }

  .fact-desc {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--c-body);
  }

  @media (min-width: 1024px) {
    .about-inner {
      grid-template-columns: 2fr 3fr;
    }
  }

  @media (min-width: 640px) {
    .about-facts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
