---
import { profile } from '../../data/content';

const year = new Date().getFullYear();
const footerLinks = [
  { href: profile.github, label: 'GitHub' },
  { href: profile.linkedin, label: 'LinkedIn' },
  { href: profile.resume, label: 'Resume' },
];
---

<footer class="footer">
  <div class="footer-inner">
    <span class="footer-name">Arnav Panigrahi</span>
    <nav class="footer-links" aria-label="Footer navigation">
      {footerLinks.map((link) => (
        <a href={link.href} class="footer-link" target="_blank" rel="noopener noreferrer">{link.label}</a>
      ))}
    </nav>
    <span class="footer-copy">&copy; {year} &middot; Crafted with care</span>
  </div>
</footer>

<button class="back-to-top" aria-label="Back to top" data-back-to-top>
  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
    <path d="M7 12V2M7 2L2 7M7 2L12 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script>
  const btn = document.querySelector('[data-back-to-top]') as HTMLButtonElement | null;
  if (btn) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          btn.classList.toggle('is-visible', window.scrollY > 600);
          ticking = false;
        });
        ticking = true;
      }
    });

    btn.addEventListener('click', () => {
      const behavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      window.scrollTo({ top: 0, behavior });
    });
  }
</script>

<style>
  .footer {
    border-top: 1px solid var(--c-rule);
    padding: 2rem clamp(1.5rem, 4vw, 3rem);
    position: relative;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(4rem, 10vw, 8rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--c-water-mint), var(--c-koi-gold), transparent);
  }

  .footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--c-muted);
  }

  .footer-name {
    font-weight: 500;
    color: var(--c-body);
    letter-spacing: 0.02em;
  }
  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-link {
    color: var(--c-muted);
    text-decoration: none;
    transition: color 300ms var(--ease-expo);
  }

  .footer-link:hover {
    color: var(--c-gold);
  }


  @media (max-width: 639px) {
    .footer-inner {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }

  .back-to-top {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--c-card-border);
    border-radius: 50%;
    background: color-mix(in oklch, var(--c-pond-850) 92%, transparent);
    backdrop-filter: blur(12px);
    color: var(--c-accent-soft);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 400ms var(--ease-expo),
      transform 400ms var(--ease-expo),
      color 300ms var(--ease-expo),
      border-color 300ms var(--ease-expo);
  }

  .back-to-top.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover {
    color: var(--c-ink);
    border-color: var(--c-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top { transition-duration: 0s; }
  }
</style>
